@model IEnumerable<Bar_QR.Models.Mesa>

@{
	ViewData["Title"] = "Mesas - " + ViewData["ZonaNombre"];
	Layout = "~/Views/Shared/_Layout.cshtml";
	var zonaId = (int)ViewData["ZonaId"]!;
	var mesas = Model.ToList();
	int mapW = mesas.Any() ? Math.Max(700, mesas.Max(m => m.PosX + m.Ancho) + 40) : 700;
	int mapH = mesas.Any() ? Math.Max(450, mesas.Max(m => m.PosY + m.Alto) + 40) : 450;
}

<style>
	body { background: #f4f1eb; }
	.mesas-header {
		background: #1a1a2e;
		color: #fff;
		padding: 1.2rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		border-bottom: 4px solid #e63946;
	}
	.mesas-header a { color: #aaa; text-decoration: none; font-size: 1.3rem; }
	.mesas-header a:hover { color: #fff; }
	.mesas-header h1 { margin: 0; font-size: 1.3rem; font-weight: 700; }
	.leyenda { display: flex; gap: 1.2rem; font-size: 0.82rem; color: #666; padding: 0.8rem 1.5rem 0.4rem; }
	.dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; margin-right: 4px; }
	.dot-libre   { background: #2a9d5c; }
	.dot-ocupada { background: #e63946; }

	#mapa-staff {
		position: relative;
		background: #eef2f7;
		border: 2px solid #ced4da;
		border-radius: 10px;
		overflow: auto;
	}
	.mesa-staff {
		position: absolute;
		border-radius: 8px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 0.85rem;
		color: #fff;
		padding: 4px;
		cursor: pointer;
		border: none;
		box-shadow: 0 2px 6px rgba(0,0,0,.2);
	}
	.mesa-staff.libre          { background: #2a9d5c; }
	.mesa-staff.ocupada        { background: #e63946; }
	.mesa-staff.pendiente-pago { background: #e69500; }
	.mesa-staff.deshabilitada  { opacity: .5; filter: grayscale(.6); }
	.mesa-staff .m-num  { font-size: 0.65rem; opacity: 0.7; }
	.mesa-staff .m-estado { font-size: 0.7rem; font-weight: 400; }
</style>

<div class="mesas-header">
	<a href="@Url.Action("Zonas", "Staff")" title="Volver">&#8592;</a>
	<h1>@ViewData["ZonaNombre"]</h1>
</div>

@if (TempData["PanelError"] is string panelErr)
{
	<div class="alert alert-warning alert-dismissible fade show mx-3 mt-3" role="alert">
		🔒 @panelErr
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="leyenda">
	<span><i class="dot dot-libre"></i> Libre</span>
	<span><i class="dot dot-ocupada"></i> Ocupada</span>
	<span><i class="dot" style="background:#e69500"></i> Pendiente de pago</span>
</div>

<div class="container-fluid px-3 py-3">
	@if (!mesas.Any())
	{
		<p class="text-center text-muted mt-4">Esta zona no tiene mesas asignadas.</p>
	}
	else
	{
		<div id="mapa-staff" style="width:100%; min-height:@(mapH)px; height:@(mapH)px;">
			@foreach (var mesa in mesas)
			{
				var clase = mesa.Estado switch {
						Bar_QR.Models.EstadoMesa.Libre         => "libre",
						Bar_QR.Models.EstadoMesa.PendientePago => "pendiente-pago",
						_                                      => "ocupada"
					};
					var claseExtra = mesa.Habilitada ? "" : " deshabilitada";
					var texto = mesa.Estado switch {
						Bar_QR.Models.EstadoMesa.Libre         => "Libre",
						Bar_QR.Models.EstadoMesa.PendientePago => "🧾 Cuenta",
						_                                      => "Ocupada"
					};
					var textoExtra = mesa.Habilitada ? "" : " 🔒";
				var nombre = string.IsNullOrWhiteSpace(mesa.Nombre) ? $"Mesa {mesa.NumeroMesa}" : mesa.Nombre;
				<a href="@Url.Action("Panel","Staff",new{mesaId=mesa.Id,zonaId})"
					   class="mesa-staff @clase@claseExtra"
					   style="position:absolute;left:@(mesa.PosX)px;top:@(mesa.PosY)px;width:@(mesa.Ancho)px;height:@(mesa.Alto)px;text-decoration:none;">
						<span class="m-num">#@mesa.NumeroMesa</span>
						<span>@nombre</span>
						<span class="m-estado">@texto@textoExtra</span>
					</a>
			}
		</div>
	}
</div>
