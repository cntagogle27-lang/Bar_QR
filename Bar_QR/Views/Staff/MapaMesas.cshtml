@model IEnumerable<Bar_QR.Models.Mesa>

@{
	ViewData["Title"] = "Mesas - " + ViewData["ZonaNombre"];
	Layout = "~/Views/Shared/_Layout.cshtml";
	var zonaId = (int)ViewData["ZonaId"]!;
}

<style>
	body { background: #f4f1eb; }
	.mesas-header {
		background: #1a1a2e;
		color: #fff;
		padding: 1.2rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		border-bottom: 4px solid #e63946;
	}
	.mesas-header a { color: #aaa; text-decoration: none; font-size: 1.3rem; }
	.mesas-header a:hover { color: #fff; }
	.mesas-header h1 { margin: 0; font-size: 1.3rem; font-weight: 700; }
	.leyenda { display: flex; gap: 1.2rem; font-size: 0.82rem; color: #666; padding: 0.8rem 1.5rem 0; }
	.leyenda span { display: flex; align-items: center; gap: 0.35rem; }
	.dot { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
	.dot-libre   { background: #2a9d5c; }
	.dot-ocupada { background: #e63946; }

	.mesa-btn {
		width: 100%;
		border: none;
		border-radius: 10px;
		padding: 1.4rem 0.5rem 1rem;
		font-weight: 700;
		font-size: 1rem;
		cursor: pointer;
		color: #fff;
		position: relative;
	}
	.mesa-btn.libre   { background: #2a9d5c; }
	.mesa-btn.ocupada { background: #e63946; }
	.mesa-btn .mesa-nombre { display: block; font-size: 1.05rem; }
	.mesa-btn .mesa-estado { display: block; font-size: 0.78rem; font-weight: 400; opacity: 0.85; margin-top: 0.2rem; }
	.mesa-btn .mesa-num {
		position: absolute; top: 6px; right: 10px;
		font-size: 0.7rem; opacity: 0.6; font-weight: 400;
	}
</style>

<div class="mesas-header">
	<a href="@Url.Action("Zonas", "Staff")" title="Volver a zonas">&#8592;</a>
	<h1>@ViewData["ZonaNombre"]</h1>
</div>

<div class="leyenda">
	<span><i class="dot dot-libre"></i> Libre</span>
	<span><i class="dot dot-ocupada"></i> Ocupada</span>
</div>

<div class="container py-3">
	@if (!Model.Any())
	{
		<p class="text-center text-muted mt-4">Esta zona no tiene mesas asignadas.</p>
	}
	else
	{
		<div class="row g-3">
			@foreach (var mesa in Model)
			{
				var clase = mesa.Estado == Bar_QR.Models.EstadoMesa.Libre ? "libre" : "ocupada";
				var texto = mesa.Estado == Bar_QR.Models.EstadoMesa.Libre ? "Libre" : "Ocupada";
				<div class="col-6 col-sm-4 col-md-3">
					<form asp-action="Toggle" method="post">
						<input type="hidden" name="mesaId" value="@mesa.Id" />
						<input type="hidden" name="zonaId" value="@zonaId" />
						<button type="submit" class="mesa-btn @clase">
							<span class="mesa-num">#@mesa.NumeroMesa</span>
							<span class="mesa-nombre">@(string.IsNullOrWhiteSpace(mesa.Nombre) ? $"Mesa {mesa.NumeroMesa}" : mesa.Nombre)</span>
							<span class="mesa-estado">@texto</span>
						</button>
					</form>
				</div>
			}
		</div>
	}
</div>
