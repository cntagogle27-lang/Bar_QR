@model IEnumerable<Bar_QR.Models.Producto>

@{
    var grupoNombres = new Dictionary<Bar_QR.Models.GrupoProducto, string>
    {
        { Bar_QR.Models.GrupoProducto.CafeInfusiones,  "☕ Café e Infusiones" },
        { Bar_QR.Models.GrupoProducto.Desayunos,       "🥐 Desayunos" },
        { Bar_QR.Models.GrupoProducto.Vinos,           "🍷 Vinos" },
        { Bar_QR.Models.GrupoProducto.Bebidas,         "🥤 Bebidas" },
        { Bar_QR.Models.GrupoProducto.Ensaladas,       "🥗 Ensaladas" },
        { Bar_QR.Models.GrupoProducto.Entrantes,       "🍢 Entrantes" },
        { Bar_QR.Models.GrupoProducto.Quesos,          "🧀 Quesos" },
        { Bar_QR.Models.GrupoProducto.Horno,           "🔥 Horno" },
        { Bar_QR.Models.GrupoProducto.Carnes,          "🥩 Carnes" },
        { Bar_QR.Models.GrupoProducto.Postres,         "🍮 Postres" },
        { Bar_QR.Models.GrupoProducto.LicoresCocteles, "🍸 Licores y Cócteles" },
    };

    var grupos = Model
        .GroupBy(p => p.Grupo)
        .OrderBy(g => (int)g.Key)
        .ToList();
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-lg-8">
            <h2 class="mb-1">🍴 Nuestra Carta</h2>
            @if (ViewData["MesaNombre"] != null)
            {
                <p class="text-muted mb-3">📍 @ViewData["MesaNombre"]</p>
            }
            else if (ViewData["MesaSeleccionada"] != null)
            {
                <p class="text-muted mb-3" data-mesa="@ViewData["MesaSeleccionada"]">
                    Mesa <strong>@ViewData["MesaSeleccionada"]</strong>
                </p>
            }

            @foreach (var grupo in grupos)
            {
                var titulo = grupoNombres.TryGetValue(grupo.Key, out var t) ? t : grupo.Key.ToString();
                <h4 class="mt-4 mb-3 border-bottom pb-2 text-dark">@titulo</h4>
                <div class="row row-cols-1 row-cols-md-2 g-3 mb-2">
                    @foreach (var item in grupo.OrderBy(p => p.Nombre))
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0">
                                @if (!string.IsNullOrEmpty(item.FotoUrl))
                                {
                                    <img src="@item.FotoUrl" class="card-img-top"
                                         alt="@item.Nombre"
                                         style="height:160px;object-fit:cover;" />
                                }
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="card-title fw-bold mb-1">@item.Nombre</h5>
                                        <p class="text-success fs-5 mb-0">@item.Precio.ToString("F2") €</p>
                                    </div>
                                    <button class="btn btn-primary rounded-pill px-3 btn-agregar"
                                            data-nombre="@System.Text.Encodings.Web.HtmlEncoder.Default.Encode(item.Nombre)"
                                            data-precio="@item.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        ➕
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-primary sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">🛒 Mi Pedido</h4>
                </div>
                <div class="card-body p-0">
                    <ul id="lista-carrito" class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                        <li class="list-group-item text-center text-muted py-4">Tu carrito está vacío</li>
                    </ul>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                        <span>Total:</span>
                        <span id="total-precio">0.00 €</span>
                    </div>
                    <button class="btn btn-success w-100 btn-lg fw-bold" id="btn-enviar-pedido">
                        🚀 ENVIAR PEDIDO
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let carrito = [];
        let total = 0;

        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.btn-agregar');
            if (!btn) return;
            const nombre = btn.dataset.nombre;
            const precio = parseFloat(btn.dataset.precio);
            if (isNaN(precio)) return;
            carrito.push({ nombre, precio });
            total += precio;
            actualizarInterfaz();
        });

        document.getElementById('btn-enviar-pedido').addEventListener('click', () => {
            if (carrito.length === 0) return alert("¡Añade algo antes de pedir!");
            const mesaElem = document.querySelector('[data-mesa]');
            const mesa = mesaElem ? mesaElem.dataset.mesa : null;
            alert("¡Pedido enviado! En breve lo recibirás.");
            carrito = [];
            total = 0;
            actualizarInterfaz();
        });

        function actualizarInterfaz() {
            const lista = document.getElementById('lista-carrito');
            const totalTxt = document.getElementById('total-precio');
            if (carrito.length === 0) {
                lista.innerHTML = '<li class="list-group-item text-center text-muted py-4">Tu carrito está vacío</li>';
            } else {
                lista.innerHTML = carrito.map(i => `
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        ${i.nombre} <span class="text-success fw-bold">${i.precio.toFixed(2)} €</span>
                    </li>`).join('');
            }
            totalTxt.innerText = total.toFixed(2) + " €";
        }
    </script>
}
