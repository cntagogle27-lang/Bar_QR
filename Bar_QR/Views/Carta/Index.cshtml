@model IEnumerable<Bar_QR.Models.Producto>
@{
    ViewData["HideNav"] = true;
    // Serializar productos con Id para el carrito
    var productosJs = System.Text.Json.JsonSerializer.Serialize(
        Model.Select(p => new { id = p.Id, nombre = p.Nombre, precio = p.Precio })
    );
}
<style>
    /* Hero de cabecera */
    .carta-hero {
        width: 100%;
        height: 260px;
        background: url('/uploads/productos/berenjenas.jpg') center center / cover no-repeat;
        position: relative;
        display: flex;
        align-items: flex-end;
        margin-bottom: 0;
    }
    .carta-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(15,15,26,0.25) 0%, rgba(15,15,26,0.92) 100%);
    }
    .carta-hero-title {
        position: relative;
        z-index: 2;
        padding: 1.5rem 2rem;
        color: #fff;
    }
    .carta-hero-title h2 { font-size: 2.2rem; font-weight: 800; margin: 0; text-shadow: 0 2px 8px rgba(0,0,0,.7); }
    .carta-hero-title p  { color: #4ecca3; margin: 0; font-size: 1rem; }
</style>

<div class="carta-hero">
    <div class="carta-hero-title">
        <h2>🍴 Nuestra Carta</h2>
        @if (ViewData["MesaNombre"] != null)
        {
            <p>📍 @ViewData["MesaNombre"]</p>
        }
        else if (ViewData["MesaSeleccionada"] != null)
        {
            <p data-mesa="@ViewData["MesaSeleccionada"]">Mesa <strong>@ViewData["MesaSeleccionada"]</strong></p>
        }
    </div>
</div>

@{
    var grupoNombres = new Dictionary<Bar_QR.Models.GrupoProducto, string>
    {
        { Bar_QR.Models.GrupoProducto.CafeInfusiones,  "☕ Café e Infusiones" },
        { Bar_QR.Models.GrupoProducto.Desayunos,       "🥐 Desayunos" },
        { Bar_QR.Models.GrupoProducto.Vinos,           "🍷 Vinos" },
        { Bar_QR.Models.GrupoProducto.Bebidas,         "🥤 Bebidas" },
        { Bar_QR.Models.GrupoProducto.Ensaladas,       "🥗 Ensaladas" },
        { Bar_QR.Models.GrupoProducto.Entrantes,       "🍢 Entrantes" },
        { Bar_QR.Models.GrupoProducto.Quesos,          "🧀 Quesos" },
        { Bar_QR.Models.GrupoProducto.Horno,           "🔥 Horno" },
        { Bar_QR.Models.GrupoProducto.Carnes,          "🥩 Carnes" },
        { Bar_QR.Models.GrupoProducto.Postres,         "🍮 Postres" },
        { Bar_QR.Models.GrupoProducto.LicoresCocteles, "🍸 Licores y Cócteles" },
    };

    var grupos = Model
        .GroupBy(p => p.Grupo)
        .OrderBy(g => (int)g.Key)
        .ToList();

    // Solo se puede pedir si hay mesa asignada (acceso por QR)
    bool puedesPedir = ViewData["MesaSeleccionada"] != null || ViewData["MesaNombre"] != null;
}

<style>
    .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.55s ease, transform 0.55s ease;
    }
    .reveal.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .reveal-delay-1 { transition-delay: 0.07s; }
    .reveal-delay-2 { transition-delay: 0.14s; }
    .card {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: #e0e0e0;
        border: 1px solid rgba(255,255,255,0.07) !important;
    }
    .card .card-title { color: #f0f0f0; }
    .card .text-success { color: #4ecca3 !important; }
    .border-bottom { border-color: rgba(255,255,255,0.15) !important; }
    h2, h4.text-dark { color: #e8e8e8 !important; }
    .container-fluid { background: #0f0f1a; min-height: 100vh; padding-bottom: 3rem; }
</style>
<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-lg-8">

            @foreach (var grupo in grupos)
            {
                var titulo = grupoNombres.TryGetValue(grupo.Key, out var t) ? t : grupo.Key.ToString();
                <h4 class="mt-4 mb-3 border-bottom pb-2 text-dark reveal">@titulo</h4>
                <div class="row row-cols-1 row-cols-md-2 g-3 mb-2">
                    @foreach (var item in grupo.OrderBy(p => p.Nombre))
                    {
                        <div class="col reveal">
                            <div class="card h-100 shadow-sm border-0">
                                    <div class="card-body d-flex align-items-center gap-3">
                                        @if (item.FotoData != null)
                                        {
                                            <img src="/Admin/FotoProducto/@item.Id"
                                                 alt="@item.Nombre"
                                                 style="width:80px;height:80px;object-fit:cover;border-radius:10px;flex-shrink:0;" />
                                        }
                                        <div class="flex-grow-1">
                                            <h5 class="card-title fw-bold mb-1">@item.Nombre</h5>
                                            <p class="text-success fs-5 mb-0">@item.Precio.ToString("F2") €</p>
                                        </div>
                                    @if (puedesPedir)
                                    {
                                        <button class="btn btn-primary rounded-pill px-3 btn-agregar"
                                                data-id="@item.Id"
                                                data-nombre="@System.Text.Encodings.Web.HtmlEncoder.Default.Encode(item.Nombre)"
                                                data-precio="@item.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            ➕
                                        </button>
                                    }
                                    </div>
                                </div>
                            </div>
                    }
                </div>
            }
        </div>

        @if (puedesPedir)
        {
        <div class="col-lg-4">
            <div class="card shadow sticky-top" style="top:20px;background:#1a1a2e;border:1.5px solid #0d6efd;">
                <div class="card-header text-white text-center" style="background:linear-gradient(135deg,#0d6efd,#0a58ca);">
                    <h4 class="mb-0">🛒 Mi Pedido</h4>
                </div>
                <div class="card-body p-0">
                    <ul id="lista-carrito" class="list-group list-group-flush" style="max-height:420px;overflow-y:auto;">
                        <li class="list-group-item text-center py-4" style="background:#1a1a2e;color:#888;">Tu carrito está vacío</li>
                    </ul>
                </div>
                <div class="card-footer" style="background:#13132a;border-top:1px solid #2a2a4a">
                    <div class="d-flex justify-content-between fw-bold fs-5 mb-3" style="color:#e0e0e0">
                        <span>Total:</span>
                        <span id="total-precio" style="color:#4ecca3">0.00 €</span>
                    </div>
                    <button class="btn btn-success w-100 btn-lg fw-bold mb-2" id="btn-enviar-pedido">
                        🚀 ENVIAR PEDIDO
                    </button>
                    <button class="btn btn-warning w-100 fw-bold d-none" id="btn-pedir-cuenta" style="color:#000">
                        🧾 PEDIR LA CUENTA
                    </button>
                    <div id="msg-pedido" class="mt-2 small text-center" style="color:#4ecca3"></div>
                </div>
            </div>
        </div>

        @* ── Modal confirmación cuenta ── *@
        <div class="modal fade" id="modalCuenta" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="background:#1a1a2e;color:#e0e0e0;border:1.5px solid #ffc107;border-radius:16px">
                    <div class="modal-body text-center py-4 px-4">
                        <div style="font-size:3.5rem;line-height:1">🧾</div>
                        <h4 class="fw-bold mt-3 mb-1">¿Pedir la cuenta?</h4>
                        <p class="text-secondary small mb-3">Se avisará al camarero para que traiga la cuenta a tu mesa.</p>
                        <div id="resumen-cuenta" class="mb-3 text-start" style="background:#13132a;border-radius:10px;padding:12px 16px;font-size:.9rem"></div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-secondary flex-grow-1" data-bs-dismiss="modal">Cancelar</button>
                            <button class="btn btn-warning fw-bold flex-grow-1" id="btn-confirmar-cuenta" style="color:#000">✅ Confirmar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
        else
        {
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 sticky-top bg-light text-center p-4" style="top:20px;">
                <div style="font-size:3rem;">📋</div>
                <h5 class="mt-2 fw-bold">Solo lectura</h5>
                <p class="text-muted small">Escanea el QR de tu mesa para poder realizar pedidos.</p>
            </div>
        </div>
        }
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    })();
</script>
    @if (puedesPedir)
    {
    <script>
        const PRODUCTOS = @Html.Raw(productosJs);
        let carrito = [];   // [{ productoId, nombre, precio, cantidad }]
        let pedidoEnviado = false;

        // ── Añadir al carrito
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.btn-agregar');
            if (!btn) return;
            const id     = parseInt(btn.dataset.id);
            const nombre = btn.dataset.nombre;
            const precio = parseFloat(btn.dataset.precio);
            if (isNaN(precio)) return;
            const item = carrito.find(i => i.productoId === id);
            if (item) item.cantidad++;
            else      carrito.push({ productoId: id, nombre, precio, cantidad: 1 });
            actualizarInterfaz();
        });

        // ── Quitar una unidad del carrito
        document.getElementById('lista-carrito').addEventListener('click', (e) => {
            const btn = e.target.closest('.btn-quitar');
            if (!btn) return;
            const id = parseInt(btn.dataset.id);
            const idx = carrito.findIndex(i => i.productoId === id);
            if (idx === -1) return;
            carrito[idx].cantidad--;
            if (carrito[idx].cantidad <= 0) carrito.splice(idx, 1);
            actualizarInterfaz();
        });

        // ── Enviar pedido
        document.getElementById('btn-enviar-pedido').addEventListener('click', async () => {
            if (carrito.length === 0) return mostrarMsg('Añade algo antes de pedir.');
            const btn = document.getElementById('btn-enviar-pedido');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando…';
            try {
                const res = await fetch('@Url.Action("EnviarPedido","Carta")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items: carrito.map(i => ({ productoId: i.productoId, cantidad: i.cantidad })) })
                });
                const data = await res.json();
                mostrarMsg(data.message);
                if (data.success) {
                    pedidoEnviado = true;
                    carrito = [];
                    actualizarInterfaz();
                    document.getElementById('btn-pedir-cuenta').classList.remove('d-none');
                }
            } catch { mostrarMsg('Error de conexión.'); }
            finally { btn.disabled = false; btn.innerHTML = '🚀 ENVIAR PEDIDO'; }
        });

        // ── Abrir modal cuenta
        document.getElementById('btn-pedir-cuenta').addEventListener('click', () => {
            // Cargar resumen de lo ya pedido (del DOM del carrito histórico, o texto genérico)
            const resumen = document.getElementById('resumen-cuenta');
            resumen.innerHTML = '<p class="mb-1" style="color:#ffc107">Se solicitará la cuenta al camarero para tu mesa.</p><p class="text-secondary mb-0 small">Asegúrate de que has pedido todo lo que deseas.</p>';
            new bootstrap.Modal(document.getElementById('modalCuenta')).show();
        });

        // ── Confirmar cuenta
        document.getElementById('btn-confirmar-cuenta').addEventListener('click', async () => {
            const btn = document.getElementById('btn-confirmar-cuenta');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando…';
            try {
                const res  = await fetch('@Url.Action("PedirCuenta","Carta")', { method: 'POST' });
                const data = await res.json();
                bootstrap.Modal.getInstance(document.getElementById('modalCuenta')).hide();
                mostrarMsg(data.message);
                if (data.success) {
                    const btnC = document.getElementById('btn-pedir-cuenta');
                    btnC.disabled = true;
                    btnC.innerHTML = '✅ Cuenta solicitada';
                }
            } catch { mostrarMsg('Error de conexión.'); }
            finally { btn.disabled = false; btn.innerHTML = '✅ Confirmar'; }
        });

        function mostrarMsg(txt) {
            const el = document.getElementById('msg-pedido');
            el.textContent = txt;
            setTimeout(() => el.textContent = '', 4000);
        }

        function actualizarInterfaz() {
            const lista    = document.getElementById('lista-carrito');
            const totalTxt = document.getElementById('total-precio');
            const total    = carrito.reduce((s, i) => s + i.precio * i.cantidad, 0);
            if (carrito.length === 0) {
                lista.innerHTML = '<li class="list-group-item text-center py-4" style="background:#1a1a2e;color:#888;">Tu carrito está vacío</li>';
            } else {
                lista.innerHTML = carrito.map(i => `
                    <li class="list-group-item" style="background:#16213e;color:#e0e0e0;border-color:#2a2a4a">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">${i.nombre}</span>
                            <span class="text-success fw-bold ms-2">${(i.precio * i.cantidad).toFixed(2)} €</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <button class="btn btn-sm btn-outline-danger rounded-circle btn-quitar" data-id="${i.productoId}" style="width:28px;height:28px;padding:0;line-height:1">−</button>
                            <span class="badge" style="background:#0d6efd;font-size:.85rem">${i.cantidad}</span>
                            <button class="btn btn-sm btn-outline-success rounded-circle btn-agregar" data-id="${i.productoId}" data-nombre="${i.nombre}" data-precio="${i.precio}" style="width:28px;height:28px;padding:0;line-height:1">+</button>
                            <span class="text-secondary small ms-auto">${i.precio.toFixed(2)} €/ud</span>
                        </div>
                    </li>`).join('');
            }
            totalTxt.innerText = total.toFixed(2) + ' €';
        }
    </script>
    }
}
