@model IEnumerable<Bar_QR.Models.Mesa>
@{
    ViewData["Title"] = "Seleccionar Mesa";
    var token = ViewData["Token"] as string;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white text-center">
            <h3>Selecciona tu mesa</h3>
        </div>
        <div class="card-body">
            <p class="text-muted">Indica el número de mesa donde estás. Tras seleccionar, verás la carta.</p>
            <div class="row row-cols-3 g-3">
                @foreach(var mesa in Model)
                {
                    <div class="col">
                        <a class="btn btn-light w-100 py-4 shadow-sm" href="@Url.Action("Index", "Carta", new { token = token, mesa = mesa.NumeroMesa })">
                            <div class="h4 mb-0">Mesa @mesa.NumeroMesa</div>
                            <small class="text-muted">@((mesa.Estado == Bar_QR.Models.EstadoMesa.Ocupada) ? "Ocupada" : "Libre")</small>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>