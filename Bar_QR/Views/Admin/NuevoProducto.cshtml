@model Bar_QR.Models.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<h1 class="text-primary">Añadir Nuevo Producto</h1>

<h4>Gestión de Carta</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Guardar" method="post" class="shadow p-4 rounded bg-light">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label fw-bold">Nombre del Producto</label>
                <input asp-for="Nombre" class="form-control" placeholder="Ej: Pizza Barbacoa" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Precio" class="control-label fw-bold">Precio (en €)</label>
                <div class="input-group">
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00" />
                    <span class="input-group-text">€</span>
                </div>
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Destino" class="control-label fw-bold">📍 Destino de Comanda</label>
                <select asp-for="Destino" class="form-control"
                        asp-items="Html.GetEnumSelectList<Bar_QR.Models.DestinoPedido>()">
                </select>
                <span asp-validation-for="Destino" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success w-100 fw-bold">
                    ✅ Guardar Producto y Configurar Destino
                </button>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Listado" class="btn btn-secondary btn-sm">⬅️ Volver al Listado</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}