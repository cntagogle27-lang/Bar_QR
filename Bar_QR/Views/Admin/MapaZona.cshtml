@model Bar_QR.Models.Zona

@{
	ViewData["Title"] = "Mapa de " + Model.Nombre;
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/interactjs/dist/interact.min.js"></script>
<script>
// Cambios pendientes: mapa de id → {posX, posY, ancho, alto, nombre}
const _cambiosPendientes = {};
// Mesas pendientes de eliminar al guardar: mapa de id → true
const _elimPendientes = {};

// Guardar posición/tamaño de una mesa al servidor
async function guardarMesa(id, posX, posY, ancho, alto, nombre) {
	const form = new FormData();
	form.append('id', id);
	form.append('posX', posX);
	form.append('posY', posY);
	form.append('ancho', ancho);
	form.append('alto', alto);
	if (nombre !== undefined) form.append('nombre', nombre);
	await fetch('/Admin/GuardarPosicionMesa', { method: 'POST', body: form });
}

document.addEventListener('DOMContentLoaded', function() {
	// Interactividad: arrastrar y redimensionar
	interact('.mesa-card')
		.draggable({
			listeners: {
				move(event) {
					const el = event.target;
					const x = (parseFloat(el.getAttribute('data-x')) || 0) + event.dx;
					const y = (parseFloat(el.getAttribute('data-y')) || 0) + event.dy;
					el.style.transform = `translate(${x}px, ${y}px)`;
					el.setAttribute('data-x', x);
					el.setAttribute('data-y', y);
				},
				end(event) {
					const el = event.target;
					const baseX = parseInt(el.dataset.baseX) || 0;
					const baseY = parseInt(el.dataset.baseY) || 0;
					const dx = parseFloat(el.getAttribute('data-x')) || 0;
					const dy = parseFloat(el.getAttribute('data-y')) || 0;
					const posX = Math.max(0, Math.round(baseX + dx));
					const posY = Math.max(0, Math.round(baseY + dy));
					el.dataset.baseX = posX;
					el.dataset.baseY = posY;
					el.style.left = posX + 'px';
					el.style.top  = posY + 'px';
					el.style.transform = '';
					el.setAttribute('data-x', 0);
					el.setAttribute('data-y', 0);
					// Acumular cambio en memoria (no guardar aún)
					const id = el.dataset.id;
					_cambiosPendientes[id] = Object.assign(_cambiosPendientes[id] || {}, {
						id, posX, posY,
						ancho: el.offsetWidth,
						alto: el.offsetHeight,
						nombre: el.querySelector('.mesa-nombre')?.textContent.trim()
					});
					marcarCambiosPendientes();
				}
			}
		})
		.resizable({
			edges: { right: true, bottom: true },
			modifiers: [
				interact.modifiers.restrictSize({ min: { width: 60, height: 50 } })
			],
			listeners: {
				move(event) {
					const el = event.target;
					el.style.width  = event.rect.width + 'px';
					el.style.height = event.rect.height + 'px';
				},
				end(event) {
					const el = event.target;
					const posX = parseInt(el.dataset.baseX) || 0;
					const posY = parseInt(el.dataset.baseY) || 0;
					// Acumular cambio en memoria (no guardar aún)
					const id = el.dataset.id;
					_cambiosPendientes[id] = Object.assign(_cambiosPendientes[id] || {}, {
						id, posX, posY,
						ancho: Math.round(el.offsetWidth),
						alto: Math.round(el.offsetHeight),
						nombre: el.querySelector('.mesa-nombre')?.textContent.trim()
					});
					marcarCambiosPendientes();
				}
			}
		});

	// Editar nombre al doble clic → abre modal
	let _renombreCard = null;
	document.querySelectorAll('.mesa-nombre').forEach(span => {
		span.addEventListener('dblclick', function() {
			_renombreCard = span.closest('.mesa-card');
			document.getElementById('inputNuevoNombre').value = span.textContent.trim();
			new bootstrap.Modal(document.getElementById('modalRenombrar')).show();
		});
	});

	document.getElementById('btnConfirmarRenombre').addEventListener('click', function() {
		const nuevoNombre = document.getElementById('inputNuevoNombre').value.trim();
		if (nuevoNombre && _renombreCard) {
			_renombreCard.querySelector('.mesa-nombre').textContent = nuevoNombre;
			const posX = parseInt(_renombreCard.dataset.baseX) || 0;
			const posY = parseInt(_renombreCard.dataset.baseY) || 0;
			const id = _renombreCard.dataset.id;
			// Acumular cambio de nombre en memoria
			_cambiosPendientes[id] = Object.assign(_cambiosPendientes[id] || {}, {
				id, posX, posY,
				ancho: _renombreCard.offsetWidth,
				alto: _renombreCard.offsetHeight,
				nombre: nuevoNombre
			});
			marcarCambiosPendientes();
			bootstrap.Modal.getInstance(document.getElementById('modalRenombrar')).hide();
		}
	});

	document.getElementById('btnGuardarTodo').addEventListener('click', async function() {
		const btn = this;
		btn.disabled = true;
		btn.textContent = '⏳ Guardando...';
		// Eliminar mesas pendientes de borrado
		const idsEliminar = Object.keys(_elimPendientes).map(Number);
		const zonaId = @Model.Id;
		await Promise.all(idsEliminar.map(id => {
			const form = new FormData();
			form.append('id', id);
			form.append('zonaId', zonaId);
			return fetch('/Admin/EliminarMesaZona', { method: 'POST', body: form, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
		}));
		// Eliminar visualmente las cards marcadas
		document.querySelectorAll('.mesa-card[data-pendiente-eliminar="true"]').forEach(el => el.remove());
		Object.keys(_elimPendientes).forEach(k => delete _elimPendientes[k]);
		// Guardar los que tienen cambios pendientes de posición/nombre
		const cambios = Object.values(_cambiosPendientes);
		const aGuardar = cambios.length > 0 ? cambios : [];
		await Promise.all(aGuardar.map(c => guardarMesa(c.id, c.posX, c.posY, c.ancho, c.alto, c.nombre)));
		// Limpiar cambios pendientes
		Object.keys(_cambiosPendientes).forEach(k => delete _cambiosPendientes[k]);
		btn.disabled = false;
		btn.textContent = '✅ Guardado';
		btn.classList.remove('btn-warning');
		btn.classList.add('btn-success');
		setTimeout(() => { btn.textContent = '💾 Guardar cambios'; }, 2000);
	});
});

function marcarCambiosPendientes() {
	const btn = document.getElementById('btnGuardarTodo');
	if (btn) {
		btn.textContent = '💾 Guardar cambios *';
		btn.classList.remove('btn-success');
		btn.classList.add('btn-warning');
	}
}
</script>
<style>
	#mapa-container {
		position: relative;
		width: 100%;
		min-height: 600px;
		background: #f0f4f8;
		border: 2px solid #ced4da;
		border-radius: 10px;
		overflow: hidden;
	}
	.mesa-card {
		position: absolute;
		background: #fff;
		border: 2px solid #0d6efd;
		border-radius: 8px;
		box-shadow: 0 2px 8px rgba(0,0,0,.15);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		cursor: move;
		user-select: none;
		touch-action: none;
		font-size: 13px;
		font-weight: 600;
		color: #0d6efd;
		min-width: 60px;
		min-height: 50px;
		padding: 4px;
	}
	.mesa-card .btn-del-mesa {
		position: absolute;
		top: 3px; right: 4px;
		font-size: 11px;
		line-height: 1;
		padding: 1px 5px;
		cursor: pointer;
	}
	.mesa-nombre {
		cursor: text;
	}
	.mesa-nombre:hover {
		text-decoration: underline dotted;
	}
	.resize-handle {
		position: absolute;
		bottom: 4px;
		right: 4px;
		width: 12px;
		height: 12px;
		background: #0d6efd;
		border-radius: 2px;
		opacity: .5;
		cursor: se-resize;
	}
</style>
}

@* Modal para renombrar mesa *@
<div class="modal fade" id="modalRenombrar" tabindex="-1" aria-labelledby="modalRenombrarLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered" style="max-width:380px">
		<div class="modal-content border-0 shadow-lg" style="background:#1a1a2e;color:#e0e0e0;border-radius:14px;">
			<div class="modal-header border-0 pb-0">
				<h5 class="modal-title fw-bold" id="modalRenombrarLabel">✏️ Renombrar mesa</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body pt-2">
				<label class="form-label small text-secondary mb-1">Nuevo nombre</label>
				<input type="text" id="inputNuevoNombre" class="form-control"
					   style="background:#0f0f1a;border:1px solid #2a2a4a;color:#e0e0e0;border-radius:8px;"
					   placeholder="Ej: Mesa VIP 1" />
			</div>
			<div class="modal-footer border-0 pt-0 gap-2">
				<button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Cancelar</button>
				<button type="button" id="btnConfirmarRenombre" class="btn btn-primary btn-sm px-4">Guardar</button>
			</div>
		</div>
	</div>
</div>

<div class="container mt-4">
	<div class="d-flex align-items-center gap-3 mb-3">
		<a asp-action="Ajustes" asp-fragment="mesas" class="btn btn-outline-secondary btn-sm">← Volver a zonas</a>
		<h4 class="mb-0">🏠 Zona: @Model.Nombre</h4>
		<form asp-action="AgregarMesaZona" method="post" class="ms-auto">
			<input type="hidden" name="zonaId" value="@Model.Id" />
			<button class="btn btn-success btn-sm">➕ Nueva mesa</button>
		</form>
	</div>

	<p class="text-muted small">💡 Arrastra para mover · Arrastra la esquina inferior derecha para redimensionar · Doble clic en el nombre para renombrarlo</p>

	<button id="btnGuardarTodo" class="btn btn-success btn-sm mb-3">💾 Guardar cambios</button>

	<div id="mapa-container">
		@foreach (var mesa in Model.Mesas)
		{
			<div class="mesa-card"
				 data-id="@mesa.Id"
				 data-base-x="@mesa.PosX"
				 data-base-y="@mesa.PosY"
				 style="left:@(mesa.PosX)px;top:@(mesa.PosY)px;width:@(mesa.Ancho)px;height:@(mesa.Alto)px;">
				<button type="button" class="btn btn-sm btn-outline-danger btn-del-mesa"
						onclick="confirmarEliminarMesa(@mesa.Id,'@Html.Raw(mesa.Nombre.Replace("'", "\\'"))',@Model.Id)">✕</button>
				<span class="mesa-nombre">@mesa.Nombre</span>
				<div class="resize-handle"></div>
			</div>
		}
	</div>
</div>

@* Modal confirmar eliminar mesa *@
<div class="modal fade" id="modalEliminarMesa" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered modal-sm">
		<div class="modal-content" style="background:#1a1a2e;color:#e0e0e0;border:1.5px solid #dc3545;border-radius:14px">
			<div class="modal-body text-center py-4 px-4">
				<div style="font-size:3rem;line-height:1">🗑️</div>
				<h5 class="fw-bold mt-3 mb-1">¿Eliminar mesa?</h5>
				<p id="elimMesaNombre" class="text-secondary small mb-4"></p>
				<div class="d-flex gap-2">
					<button class="btn btn-secondary flex-grow-1" data-bs-dismiss="modal">Cancelar</button>
					<button type="button" id="btnConfirmarEliminar" class="btn btn-danger flex-grow-1">Eliminar</button>
				</div>
			</div>
		</div>
	</div>
</div>
<script>
let _mesaCardAEliminar = null;
let _elimMesaIdPendiente = 0;
let _elimZonaId = 0;

function confirmarEliminarMesa(id, nombre, zonaId) {
	_elimMesaIdPendiente = id;
	_elimZonaId = zonaId;
	_mesaCardAEliminar = document.querySelector(`.mesa-card[data-id="${id}"]`);
	document.getElementById('elimMesaNombre').textContent = 'Se eliminará "' + nombre + '" de forma permanente al guardar.';
	new bootstrap.Modal(document.getElementById('modalEliminarMesa')).show();
}

document.getElementById('btnConfirmarEliminar').addEventListener('click', function() {
	if (_mesaCardAEliminar) {
		_mesaCardAEliminar.style.opacity = '0.3';
		_mesaCardAEliminar.style.pointerEvents = 'none';
		_mesaCardAEliminar.dataset.pendienteEliminar = 'true';
	}
	_elimPendientes[_elimMesaIdPendiente] = true;
	// Quitar de cambios pendientes de posición si existía
	delete _cambiosPendientes[_elimMesaIdPendiente];
	marcarCambiosPendientes();
	bootstrap.Modal.getInstance(document.getElementById('modalEliminarMesa')).hide();
});
</script>
