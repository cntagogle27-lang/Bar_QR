@model IEnumerable<Bar_QR.Models.Producto>

@{
    ViewData["Title"] = "Listado de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">📋 Gestión de Productos</h1>
        <div>
            <a asp-action="NuevoProducto" class="btn btn-success fw-bold">➕ Añadir Nuevo Producto</a>
            <a asp-action="Ajustes" class="btn btn-outline-secondary fw-bold ms-2">⚙️ Ajustes</a>
        </div>
    </div>

    <table class="table table-hover shadow-sm bg-white rounded">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre del Plato</th>
                <th>Precio</th>
                <th class="text-center">📍 Destino</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold text-muted">#@item.Id</td>
                    <td class="fw-bold">@item.Nombre</td>
                    <td class="text-success fw-bold">@item.Precio.ToString("F2") €</td>
                    <td class="text-center">
                        @if (item.DestinoImpresion.ToString() == "Cocina")
                        {
                            <span class="badge bg-danger p-2"><i class="bi bi-egg-fried"></i> 🍳 Cocina</span>
                        }
                        else if (item.DestinoImpresion.ToString() == "Barra")
                        {
                            <span class="badge bg-warning text-dark p-2">🍺 Barra</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark p-2">🔄 Ambos</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-group" role="group">
                            <a href="#" class="btn btn-outline-primary btn-sm">📝 Editar</a>
                            <a href="#" class="btn btn-outline-danger btn-sm">🗑️ Borrar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Aún no hay productos. ¡Pulsa el botón de arriba para crear el primero!
        </div>
    }
</div>