@model IEnumerable<Bar_QR.Models.Zona>
@using System.Text.Json

@{
	ViewData["Title"] = "Control de Mesas";
	var pluses       = ViewData["Pluses"]       as List<Bar_QR.Models.Plus>       ?? new();
	var reglasCierre = ViewData["ReglasCierre"] as List<Bar_QR.Models.ReglasCierre> ?? new();

	string[] diasNombres = { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };

	List<int> ParseDias(string json) {
		try { return JsonSerializer.Deserialize<List<int>>(json) ?? new(); } catch { return new(); }
	}
}

<a href="@Url.Action("Ajustes","Admin")" class="btn btn-outline-secondary btn-sm mb-3">← Volver a Ajustes</a>

<style>
	.zona-card {
		background: #1a1a2e;
		border: 1px solid #2a2a4a;
		border-radius: 14px;
		color: #e0e0e0;
		transition: box-shadow .2s;
	}
	.zona-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,.4); }
	.zona-card.deshabilitada { opacity: .55; border-color: #ff6b6b44; }
	.badge-hab  { background: #1db954; color: #fff; }
	.badge-desh { background: #ff6b6b; color: #fff; }
	.btn-toggle-on  { background: transparent; border: 1px solid #ff6b6b; color: #ff6b6b; }
	.btn-toggle-on:hover  { background: #ff6b6b22; color: #ff6b6b; }
	.btn-toggle-off { background: transparent; border: 1px solid #1db954; color: #1db954; }
	.btn-toggle-off:hover { background: #1db95422; color: #1db954; }
	.btn-ver-mapa { background: #0d6efd22; border: 1px solid #0d6efd; color: #6ea8fe; }
	.btn-ver-mapa:hover { background: #0d6efd44; color: #6ea8fe; }
	.stat-pill { font-size: .75rem; padding: 2px 10px; border-radius: 20px; }
	.stat-libre   { background: #1db95422; color: #1db954; border: 1px solid #1db95455; }
	.stat-ocupada { background: #ffc10722; color: #ffc107; border: 1px solid #ffc10755; }
</style>

<div class="container mt-4">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h3 class="mb-0 fw-bold" style="color:#e0e0e0;">🗂️ Control de Mesas</h3>
			<p class="text-secondary small mb-0">Habilita o deshabilita zonas enteras. Entra en una zona para gestionar mesas individuales.</p>
		</div>
		<a asp-action="Ajustes" class="btn btn-sm btn-outline-secondary">← Ajustes</a>
	</div>

	@if (TempData["ControlOk"] is string ok)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">@ok
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
	}

	@if (!Model.Any())
	{
		<div class="text-center py-5" style="color:#555577;">
			<div style="font-size:2.5rem;">🏠</div>
			<p class="mt-2">No hay zonas creadas aún. Créalas desde <a asp-action="Ajustes" asp-fragment="mesas">Ajustes → Mesas</a>.</p>
		</div>
	}

	<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
		@foreach (var zona in Model)
		{
			var libres   = zona.Mesas.Count(m => m.Estado == Bar_QR.Models.EstadoMesa.Libre && m.Habilitada);
			var ocupadas = zona.Mesas.Count(m => m.Estado != Bar_QR.Models.EstadoMesa.Libre && m.Habilitada);
			var deshabMesas = zona.Mesas.Count(m => !m.Habilitada);

			<div class="col">
				<div class="zona-card p-4 @(!zona.Habilitada ? "deshabilitada" : "")">
					<div class="d-flex justify-content-between align-items-start mb-3">
						<div>
							<h5 class="fw-bold mb-1">🏠 @zona.Nombre</h5>
							<div class="d-flex gap-2 flex-wrap">
								<span class="badge @(zona.Habilitada ? "badge-hab" : "badge-desh") stat-pill">
									@(zona.Habilitada ? "Habilitada" : "Deshabilitada")
								</span>
								<span class="stat-pill stat-libre">@libres libres</span>
								<span class="stat-pill stat-ocupada">@ocupadas ocupadas</span>
								@if (deshabMesas > 0)
								{
									<span class="stat-pill" style="background:#ff6b6b22;color:#ff6b6b;border:1px solid #ff6b6b55;">@deshabMesas deshabilitadas</span>
								}
							</div>
						</div>
						<span class="text-secondary small">@zona.Mesas.Count mesas</span>
					</div>

					<div class="d-flex gap-2 mt-3 flex-wrap">
							<a asp-action="ControlMapaZona" asp-route-zonaId="@zona.Id"
							   class="btn btn-sm btn-ver-mapa flex-grow-1">
								🗺️ Ver mesas
							</a>
							<button class="btn btn-sm btn-outline-warning"
									data-bs-toggle="offcanvas"
									data-bs-target="#ocPlus@(zona.Id)">
								💰 Pluses
							</button>
							<button class="btn btn-sm btn-outline-info"
									data-bs-toggle="offcanvas"
									data-bs-target="#ocCierre@(zona.Id)">
								🔒 Cierres
							</button>
							<button type="button"
									onclick="toggleZona(@zona.Id)"
									class="btn btn-sm @(zona.Habilitada ? "btn-toggle-on" : "btn-toggle-off")">
								@(zona.Habilitada ? "🔒 Deshabilitar" : "✅ Habilitar")
							</button>
						</div>
				</div>
			</div>
		}
	</div>
</div>

@* ══ OFFCANVAS de Pluses y Reglas por zona ══════════════════════════════════ *@
@foreach (var zona in Model)
{
	var zPluses  = pluses.Where(p => p.ZonaId == zona.Id).ToList();
	var zReglas  = reglasCierre.Where(r => r.ZonaId == zona.Id).ToList();
	string ocPlusId   = $"ocPlus{zona.Id}";
	string ocCierreId = $"ocCierre{zona.Id}";

	@* ── Offcanvas PLUSES ── *@
	<div class="offcanvas offcanvas-end" tabindex="-1" id="@ocPlusId"
		 style="background:#13132a;color:#e0e0e0;border-left:1.5px solid #2a2a4a;width:420px">
		<div class="offcanvas-header" style="border-bottom:1px solid #2a2a4a">
			<h5 class="offcanvas-title">💰 Pluses — @zona.Nombre</h5>
			<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
		</div>
		<div class="offcanvas-body">
			<p class="text-secondary small">Recargos que se suman al total del ticket. Si no se marcan días, aplica siempre.</p>
			<button class="btn btn-sm btn-outline-success mb-3 w-100"
					onclick="abrirModalPlus(0,'Plus','[]',true,0,@zona.Id)">➕ Nuevo plus en @zona.Nombre</button>

			@if (!zPluses.Any())
			{
				<div class="text-secondary small">Sin pluses configurados.</div>
			}
			@foreach (var p in zPluses)
			{
				var dias = ParseDias(p.DiasJson);
				<div class="zona-card p-3 mb-2 @(!p.Activo ? "deshabilitada" : "")">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<span class="fw-bold">@p.Nombre</span>
							<span class="stat-pill @(p.Activo ? "badge-hab" : "badge-desh") ms-2" style="font-size:.68rem">
								@(p.Activo ? "Activo" : "Inactivo")
							</span>
						</div>
						<span class="fw-bold" style="color:#6ea8fe">@p.Porcentaje.ToString("0.##")%</span>
					</div>
					<div class="mt-1" style="font-size:.76rem;color:#aaa">
						@(dias.Any() ? string.Join(", ", dias.Select(d => diasNombres[d])) : "Todos los días")
					</div>
					<div class="d-flex gap-2 mt-2">
						<button class="btn btn-sm btn-outline-primary flex-grow-1"
								onclick="abrirModalPlus(@p.Id,'@Html.Raw(p.Nombre.Replace("\\","\\\\").Replace("'","\\'"))','@Html.Raw(p.DiasJson)',@p.Activo.ToString().ToLower(),@p.Porcentaje.ToString(System.Globalization.CultureInfo.InvariantCulture),@p.ZonaId)">
							✏️ Editar
						</button>
						<form asp-action="EliminarPlus" method="post" class="m-0"
							  onsubmit="return confirm('¿Eliminar «@p.Nombre»?')">
							<input type="hidden" name="id" value="@p.Id" />
							<button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
						</form>
					</div>
				</div>
			}
		</div>
	</div>

	@* ── Offcanvas CIERRE ── *@
	<div class="offcanvas offcanvas-end" tabindex="-1" id="@ocCierreId"
		 style="background:#13132a;color:#e0e0e0;border-left:1.5px solid #2a2a4a;width:420px">
		<div class="offcanvas-header" style="border-bottom:1px solid #2a2a4a">
			<h5 class="offcanvas-title">🔒 Cierres automáticos — @zona.Nombre</h5>
			<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
		</div>
		<div class="offcanvas-body">
			<p class="text-secondary small">Franjas en las que las mesas de esta zona se bloquean automáticamente.</p>
			<button class="btn btn-sm btn-outline-success mb-3 w-100"
					onclick="abrirModalCierre(0,'Cierre','[]','00:00','23:00',true,@zona.Id)">➕ Nueva regla en @zona.Nombre</button>

			@if (!zReglas.Any())
			{
				<div class="text-secondary small">Sin reglas de cierre configuradas.</div>
			}
			@foreach (var r in zReglas)
			{
				var dias = ParseDias(r.DiasJson);
				<div class="zona-card p-3 mb-2 @(!r.Activa ? "deshabilitada" : "")">
					<div class="d-flex justify-content-between align-items-center">
						<div>
							<span class="fw-bold">@r.Nombre</span>
							<span class="stat-pill @(r.Activa ? "badge-hab" : "badge-desh") ms-2" style="font-size:.68rem">
								@(r.Activa ? "Activa" : "Inactiva")
							</span>
						</div>
						<span class="fw-bold" style="color:#ffc107">@r.HoraInicio–@r.HoraFin</span>
					</div>
					<div class="mt-1" style="font-size:.76rem;color:#aaa">
						@(dias.Any() ? string.Join(", ", dias.Select(d => diasNombres[d])) : "Todos los días")
					</div>
					<div class="d-flex gap-2 mt-2">
						<button class="btn btn-sm btn-outline-primary flex-grow-1"
								onclick="abrirModalCierre(@r.Id,'@Html.Raw(r.Nombre.Replace("\\","\\\\").Replace("'","\\'"))','@Html.Raw(r.DiasJson)','@r.HoraInicio','@r.HoraFin',@r.Activa.ToString().ToLower(),@r.ZonaId)">
							✏️ Editar
						</button>
						<form asp-action="EliminarReglaCierre" method="post" class="m-0"
							  onsubmit="return confirm('¿Eliminar «@r.Nombre»?')">
							<input type="hidden" name="id" value="@r.Id" />
							<button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
						</form>
					</div>
				</div>
			}
		</div>
	</div>
}

@* ══ MODAL PLUS (compartido) ═══════════════════════════════════════════════ *@
<div class="modal fade" id="modalPlus" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content" style="background:#1a1a2e;color:#e0e0e0;border:1px solid #2a2a4a">
			<div class="modal-header" style="border-color:#2a2a4a">
				<h5 class="modal-title" id="tituloPlus">Plus</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="GuardarPlus" method="post">
				<div class="modal-body">
					<input type="hidden" name="id"     id="plusId" />
					<input type="hidden" name="zonaId" id="plusZonaId" />
					<div class="mb-3">
						<label class="form-label">Nombre</label>
						<input type="text" class="form-control bg-dark text-light border-secondary" name="nombre" id="plusNombre" required />
					</div>
					<div class="mb-3">
						<label class="form-label">Porcentaje (%)</label>
						<input type="number" step="0.01" min="0" max="999" class="form-control bg-dark text-light border-secondary" name="porcentaje" id="plusPorcentaje" required />
					</div>
					<div class="mb-3">
						<label class="form-label d-block">Días de la semana <small class="text-secondary">(ninguno = todos)</small></label>
						<div class="d-flex flex-wrap gap-2">
							@for (int d = 0; d < 7; d++)
							{
								<div class="form-check form-check-inline">
									<input class="form-check-input plus-dia" type="checkbox" value="@d" id="plusDia@d" />
									<label class="form-check-label" for="plusDia@d">@diasNombres[d]</label>
								</div>
							}
						</div>
						<input type="hidden" name="diasJson" id="plusDiasJson" value="[]" />
					</div>
					<div class="form-check">
						<input class="form-check-input" type="checkbox" name="activo" id="plusActivo" value="true" checked />
						<label class="form-check-label" for="plusActivo">Activo</label>
					</div>
				</div>
				<div class="modal-footer" style="border-color:#2a2a4a">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
					<button type="submit" class="btn btn-primary">💾 Guardar</button>
				</div>
			</form>
		</div>
	</div>
</div>

@* ══ MODAL CIERRE (compartido) ════════════════════════════════════════════ *@
<div class="modal fade" id="modalCierre" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content" style="background:#1a1a2e;color:#e0e0e0;border:1px solid #2a2a4a">
			<div class="modal-header" style="border-color:#2a2a4a">
				<h5 class="modal-title" id="tituloCierre">Regla de cierre</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<form asp-action="GuardarReglaCierre" method="post">
				<div class="modal-body">
					<input type="hidden" name="id"     id="cierreId" />
					<input type="hidden" name="zonaId" id="cierreZonaId" />
					<div class="mb-3">
						<label class="form-label">Nombre</label>
						<input type="text" class="form-control bg-dark text-light border-secondary" name="nombre" id="cierreNombre" required />
					</div>
					<div class="row g-2 mb-3">
						<div class="col">
							<label class="form-label">Desde</label>
							<input type="time" class="form-control bg-dark text-light border-secondary" name="horaInicio" id="cierreInicio" />
						</div>
						<div class="col">
							<label class="form-label">Hasta</label>
							<input type="time" class="form-control bg-dark text-light border-secondary" name="horaFin" id="cierreFin" />
						</div>
					</div>
					<div class="mb-3">
						<label class="form-label d-block">Días de la semana <small class="text-secondary">(ninguno = todos)</small></label>
						<div class="d-flex flex-wrap gap-2">
							@for (int d = 0; d < 7; d++)
							{
								<div class="form-check form-check-inline">
									<input class="form-check-input cierre-dia" type="checkbox" value="@d" id="cierreDia@d" />
									<label class="form-check-label" for="cierreDia@d">@diasNombres[d]</label>
								</div>
							}
						</div>
						<input type="hidden" name="diasJson" id="cierreDiasJson" value="[]" />
					</div>
					<div class="form-check">
						<input class="form-check-input" type="checkbox" name="activa" id="cierreActiva" value="true" checked />
						<label class="form-check-label" for="cierreActiva">Activa</label>
					</div>
				</div>
				<div class="modal-footer" style="border-color:#2a2a4a">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
					<button type="submit" class="btn btn-primary">💾 Guardar</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function toggleZona(id) {
	// Cerrar cualquier offcanvas/modal abierto antes de hacer la petición
	document.querySelectorAll('.offcanvas.show').forEach(el => {
		bootstrap.Offcanvas.getInstance(el)?.hide();
	});
	fetch('/Admin/ToggleHabilitarZona', {
		method: 'POST',
		headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
		body: 'id=' + id
	}).then(r => {
		if (r.ok || r.redirected) window.location.reload();
		else alert('Error al cambiar el estado de la zona.');
	}).catch(() => window.location.reload());
}
function abrirModalPlus(id, nombre, diasJson, activo, porcentaje, zonaId) {
	// Cerrar cualquier offcanvas abierto antes de mostrar el modal
	document.querySelectorAll('.offcanvas.show').forEach(el => {
		bootstrap.Offcanvas.getInstance(el)?.hide();
	});
	document.getElementById('plusId').value         = id;
	document.getElementById('plusZonaId').value     = zonaId;
	document.getElementById('plusNombre').value     = nombre;
	document.getElementById('plusPorcentaje').value = porcentaje || 0;
	document.getElementById('plusActivo').checked   = activo;
	var dias = [];
	try { dias = JSON.parse(diasJson); } catch {}
	document.querySelectorAll('.plus-dia').forEach(cb => {
		cb.checked = dias.includes(parseInt(cb.value));
	});
	sincDiasPlusJson();
	document.getElementById('tituloPlus').textContent = id ? '✏️ Editar plus' : '➕ Nuevo plus';
	new bootstrap.Modal(document.getElementById('modalPlus')).show();
}
document.querySelectorAll('.plus-dia').forEach(cb => cb.addEventListener('change', sincDiasPlusJson));
function sincDiasPlusJson() {
	document.getElementById('plusDiasJson').value =
		JSON.stringify([...document.querySelectorAll('.plus-dia:checked')].map(c => parseInt(c.value)));
}

function abrirModalCierre(id, nombre, diasJson, inicio, fin, activa, zonaId) {
	// Cerrar cualquier offcanvas abierto antes de mostrar el modal
	document.querySelectorAll('.offcanvas.show').forEach(el => {
		bootstrap.Offcanvas.getInstance(el)?.hide();
	});
	document.getElementById('cierreId').value       = id;
	document.getElementById('cierreZonaId').value   = zonaId;
	document.getElementById('cierreNombre').value   = nombre;
	document.getElementById('cierreInicio').value   = inicio;
	document.getElementById('cierreFin').value      = fin;
	document.getElementById('cierreActiva').checked = activa;
	var dias = [];
	try { dias = JSON.parse(diasJson); } catch {}
	document.querySelectorAll('.cierre-dia').forEach(cb => {
		cb.checked = dias.includes(parseInt(cb.value));
	});
	sincDiasCierreJson();
	document.getElementById('tituloCierre').textContent = id ? '✏️ Editar regla' : '➕ Nueva regla';
	new bootstrap.Modal(document.getElementById('modalCierre')).show();
}
document.querySelectorAll('.cierre-dia').forEach(cb => cb.addEventListener('change', sincDiasCierreJson));
function sincDiasCierreJson() {
	document.getElementById('cierreDiasJson').value =
		JSON.stringify([...document.querySelectorAll('.cierre-dia:checked')].map(c => parseInt(c.value)));
}
</script>
}


