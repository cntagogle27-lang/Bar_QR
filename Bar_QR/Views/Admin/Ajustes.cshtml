@model Bar_QR.Models.AdminAjustesViewModel

@{
    ViewData["Title"] = "Ajustes";
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/interactjs/dist/interact.min.js"></script>
<script>
// ── Estado del editor ──────────────────────────────────────────────
const estado = { cabecera: [], pie: [] };

// ── Cargar JSON inicial desde servidor ──────────────────────────────
function cargarZona(zona, json) {
    try { estado[zona] = JSON.parse(json) || []; } catch { estado[zona] = []; }
    renderZona(zona);
}

// Ejecutar carga de zonas cuando el DOM esté listo
function inicializarEditor() {
    const cabeceraInput = document.getElementById('cabeceraJson');
    const pieInput = document.getElementById('pieJson');
    if (cabeceraInput && pieInput) {
        cargarZona('cabecera', cabeceraInput.value);
        cargarZona('pie', pieInput.value);
    }
}

// ── Render de una zona ─────────────────────────────────────────────
function renderZona(zona) {
    const cont = document.getElementById('zona-' + zona);
    cont.innerHTML = '';
    estado[zona].forEach((el, i) => crearElementoDOM(zona, el, i));
    actualizarPreview();
}

function crearElementoDOM(zona, el, i) {
    const cont = document.getElementById('zona-' + zona);
    const div  = document.createElement('div');
    div.className = 'ticket-elemento';
    div.style.left   = (el.x || 10) + 'px';
    div.style.top    = (el.y || 10) + 'px';
    div.style.width  = (el.w || 120) + 'px';
    div.style.height = (el.h || 36) + 'px';
    div.dataset.zona  = zona;
    div.dataset.index = i;

    if (el.tipo === 'texto') {
        const span = document.createElement('span');
        span.contentEditable = 'true';
        span.innerText = el.contenido || 'Texto';
        span.style.fontSize = (el.fs || 13) + 'px';
        span.style.display  = 'block';
        span.style.width    = '100%';
        span.addEventListener('input', () => { estado[zona][i].contenido = span.innerText; serializarZona(zona); actualizarPreview(); });
        div.appendChild(span);
    } else if (el.tipo === 'imagen') {
        const img = document.createElement('img');
        img.src   = '/Admin/ImagenTicket/' + el.imgId;
        img.style.width  = '100%';
        img.style.height = '100%';
        img.style.objectFit = 'contain';
        div.appendChild(img);
    }

    const btnDel = document.createElement('button');
    btnDel.className = 'btn btn-danger btn-del';
    btnDel.innerHTML = '✕';
    btnDel.onclick = () => { estado[zona].splice(i, 1); renderZona(zona); };
    div.appendChild(btnDel);

    cont.appendChild(div);
    activarInteract(div, zona, i);
}

// ── interact.js: drag + resize ─────────────────────────────────────
function activarInteract(div, zona, i) {
    interact(div)
        .draggable({
            listeners: {
                move(e) {
                    const x = (parseFloat(div.dataset.x) || 0) + e.dx;
                    const y = (parseFloat(div.dataset.y) || 0) + e.dy;
                    div.style.transform = `translate(${x}px,${y}px)`;
                    div.dataset.x = x; div.dataset.y = y;
                    const rect = div.parentElement.getBoundingClientRect();
                    const base = div.getBoundingClientRect();
                    estado[zona][i].x = base.left - rect.left;
                    estado[zona][i].y = base.top  - rect.top;
                    serializarZona(zona); actualizarPreview();
                }
            }
        })
        .resizable({ edges: { right: true, bottom: true, bottomRight: true }, listeners: {
            move(e) {
                div.style.width  = e.rect.width  + 'px';
                div.style.height = e.rect.height + 'px';
                estado[zona][i].w = e.rect.width;
                estado[zona][i].h = e.rect.height;
                serializarZona(zona); actualizarPreview();
            }
        }});
}

// ── Serializar al input hidden ─────────────────────────────────────
function serializarZona(zona) {
    document.getElementById(zona + 'Json').value = JSON.stringify(estado[zona]);
}

// ── Añadir texto ──────────────────────────────────────────────────
function agregarTexto(zona) {
    estado[zona].push({ tipo: 'texto', contenido: 'Texto', x: 10, y: 10 + estado[zona].length * 40, w: 180, h: 36 });
    renderZona(zona);
}

// ── Subir imagen al servidor y añadir elemento ────────────────────
function subirImagen(input, zona) {
    const file = input.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('imagen', file);
    fd.append('zona', zona);
    fetch('/Admin/SubirImagenTicket', { method: 'POST', body: fd,
        headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
    }).then(r => r.json()).then(data => {
        estado[zona].push({ tipo: 'imagen', imgId: data.id, nombre: data.nombre, x: 10, y: 10, w: 100, h: 80 });
        renderZona(zona);
    });
    input.value = '';
}

// ── Vista previa ───────────────────────────────────────────────────
// Datos de ejemplo basados en el ticket real proporcionado
const PREVIEW_ITEMS = [
    { uds: 2, nombre: 'Coca cola',              precio: 3.50, total: 7.00 },
    { uds: 1, nombre: 'Whisky',                 precio: 2.50, total: 2.50 },
    { uds: 1, nombre: 'Red Bull',               precio: 6.30, total: 6.30 },
    { uds: 1, nombre: 'Solomillo al oporto',    precio: 18.32, total: 18.32 },
    { uds: 1, nombre: 'Menú del día',           precio: 10.00, total: 10.00 },
    { uds: 1, nombre: 'Coca cola',              precio: 0.00, total: 0.00 }
];

function fmtEur(v) { return v.toFixed(2).replace('.', ',') + ' €'; }
const ANCHO = 38;
const SEP_GRUESO = '*'.repeat(ANCHO);
const SEP_FINO = '-'.repeat(ANCHO);

function actualizarPreview() {
    // ── Cabecera (elementos del editor) ─────────────────────────────
    const cab = document.getElementById('prev-cabecera');
    cab.innerHTML = '';
    estado.cabecera.forEach(el => {
        const d = document.createElement('div');
        d.style.cssText = `position:absolute;left:${el.x||0}px;top:${el.y||0}px;width:${el.w||100}px;`;
        if (el.tipo === 'texto') { d.innerText = el.contenido || ''; d.style.fontSize = '10px'; d.style.whiteSpace = 'pre'; }
        else if (el.tipo === 'imagen') { d.innerHTML = `<img src="/Admin/ImagenTicket/${el.imgId}" style="max-width:100%;max-height:60px;object-fit:contain;">`; }
        cab.appendChild(d);
    });
    cab.style.minHeight = estado.cabecera.length ? '80px' : '10px';

    // ── Cuerpo del ticket ─────────────────────────────────────────
    const cuerpo = document.getElementById('prev-cuerpo');
    let lineas = [];

    lineas.push(SEP_GRUESO);
    lineas.push('        FACTURA SIMPLIFICADA        ');
    lineas.push(SEP_GRUESO);
    lineas.push('');
    lineas.push('Nº Op.:  T-1             Salón/Mesa 1');
    lineas.push(SEP_GRUESO);

    // Fecha y hora
    const ahora = new Date();
    const dd = String(ahora.getDate()).padStart(2, '0');
    const mm = String(ahora.getMonth() + 1).padStart(2, '0');
    const yyyy = ahora.getFullYear();
    const hh = String(ahora.getHours()).padStart(2, '0');
    const min = String(ahora.getMinutes()).padStart(2, '0');

    const mostrarHora = document.getElementById('chkHora')?.checked;
    const mostrarUsuario = document.getElementById('chkUsuario')?.checked;

    if (mostrarHora) {
        lineas.push(`${dd}/${mm}/${yyyy} ${hh}:${min}`);
    } else {
        lineas.push(`${dd}/${mm}/${yyyy}`);
    }

    if (mostrarUsuario) {
        lineas.push('Camarero: [nombre]');
    }

    lineas.push(SEP_FINO);

    // Cabecera de productos
    lineas.push('Uds.  Producto                Importe');
    lineas.push(SEP_FINO);

    // Productos
    let total = 0;
    const mostrarDesglose = document.getElementById('chkDesglose')?.checked;

    if (mostrarDesglose) {
        PREVIEW_ITEMS.forEach(item => {
            total += item.total;
            const udsStr = String(item.uds).padStart(3, ' ');
            const nombreStr = item.nombre.padEnd(22, ' ').substring(0, 22);
            const precioStr = fmtEur(item.precio).padStart(9, ' ');
            lineas.push(`  ${udsStr}  ${nombreStr}  ${precioStr}`);
        });
    } else {
        PREVIEW_ITEMS.forEach(item => { total += item.total; });
    }

    lineas.push(SEP_GRUESO);

    // Impuestos (NO SUMAN, son PORCENTAJE del total)
    const mostrarImpuestos = document.getElementById('chkImpuestos')?.checked;

    if (mostrarImpuestos) {
        // Calcular base e impuestos: Base = Total / (1 + porcentaje), Cuota = Total - Base
        const porcentaje = 0.10; // 10%
        const base = total / (1 + porcentaje);
        const cuota = total - base;

        lineas.push('');
        lineas.push(`7 %  Base:   ${fmtEur(base).padStart(8)}  Cuota:   ${fmtEur(cuota).padStart(8)}`);
        lineas.push(`           Total:   ${fmtEur(total).padStart(8)}  Total:   ${fmtEur(cuota).padStart(8)}`);
        lineas.push(`Total (Impuestos Incl.)      ${fmtEur(total).padStart(8)}`);
        lineas.push(SEP_GRUESO);
        lineas.push('');
        lineas.push(`Entregado:     ${fmtEur(total).padStart(8)}  Cambio:       0,00 €`);
        lineas.push(`Efectivo                     ${fmtEur(total).padStart(8)}`);
    } else {
        lineas.push('');
        lineas.push(`                     TOTAL:  ${fmtEur(total)}`);
    }

    lineas.push(SEP_GRUESO);

    cuerpo.innerHTML = lineas.map(l => `<div style="font-family:'Courier New',monospace;font-size:10px;line-height:1.3;white-space:pre;">${l}</div>`).join('');

    // ── Pie (elementos del editor) ──────────────────────────────────
    const pie = document.getElementById('prev-pie');
    pie.innerHTML = '';
    estado.pie.forEach(el => {
        const d = document.createElement('div');
        d.style.cssText = `position:absolute;left:${el.x||0}px;top:${el.y||0}px;width:${el.w||100}px;text-align:center;`;
        if (el.tipo === 'texto') { d.innerText = el.contenido || ''; d.style.fontSize = '10px'; d.style.whiteSpace = 'pre'; d.style.fontWeight = 'bold'; }
        else if (el.tipo === 'imagen') { d.innerHTML = `<img src="/Admin/ImagenTicket/${el.imgId}" style="max-width:100%;max-height:40px;object-fit:contain;">`; }
        pie.appendChild(d);
    });
    pie.style.minHeight = '50px';
}

// Activar pestaña tickets si viene en el hash
if (location.hash === '#tickets') {
    document.getElementById('tickets-tab')?.click();
}

// Renderizar preview inicial al cargar la página
window.addEventListener('DOMContentLoaded', function() {
    console.log('DOM cargado, inicializando...');
    inicializarEditor();
    actualizarPreview();
});

// También actualizar cuando se active la pestaña de tickets
document.addEventListener('DOMContentLoaded', function() {
    const ticketsTab = document.getElementById('tickets-tab');
    if (ticketsTab) {
        ticketsTab.addEventListener('click', function() {
            console.log('Pestaña Tickets activada');
            setTimeout(function() {
                inicializarEditor();
                actualizarPreview();
            }, 100);
        });
    }
});
</script>
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0">Ajustes del sistema</h4>
        </div>
        <div class="card-body">
            @if (ViewData["AjustesError"] is string ajustesErrorView)
            {
                <div class="alert alert-danger">@ajustesErrorView</div>
            }
            @if (TempData["AjustesError"] is string ajustesError)
            {
                <div class="alert alert-danger">@ajustesError</div>
            }
            @if (TempData["AjustesOk"] is string ajustesOk)
            {
                <div class="alert alert-success">@ajustesOk</div>
            }

            <ul class="nav nav-tabs mb-4" id="ajustesTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="empleados-tab" data-bs-toggle="tab" data-bs-target="#empleados" type="button" role="tab">
                        👤 Empleados
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="mesas-tab" data-bs-toggle="tab" data-bs-target="#mesas-tab-pane" type="button" role="tab">
                        🗺 Mesas
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets-tab-pane" type="button" role="tab">
                        🧾 Tickets
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="qr-tab" data-bs-toggle="tab" data-bs-target="#qr-tab-pane" type="button" role="tab">
                        📱 QR
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" href="/Admin/Impresoras">
                        🖨️ Impresoras
                    </a>
                </li>
            </ul>

            <div class="tab-content" id="ajustesTabContent">

                @* TAB: EMPLEADOS *@
                <div class="tab-pane fade show active" id="empleados" role="tabpanel">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Empleados</h5>
                        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoEmpleado">➕ Nuevo empleado</button>
                    </div>

                    <div class="row g-3">
                        @foreach (var emp in Model.Empleados)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="card h-100 text-center p-2 shadow-sm">
                                    @if (emp.AvatarTipo == "custom" && emp.FotoData != null)
                                    {
                                        <img src="/Admin/FotoEmpleado/@emp.Id" class="rounded-circle mx-auto mt-2" style="width:72px;height:72px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <img src="/img/avatars/@(emp.AvatarTipo).svg" class="rounded-circle mx-auto mt-2" style="width:72px;height:72px;" onerror="this.src='/img/avatars/avatar_h1.svg'" />
                                    }
                                    <div class="card-body p-1">
                                        <p class="fw-bold mb-1">@emp.Nombre</p>
                                        <button class="btn btn-sm btn-outline-secondary w-100 mb-1"
                                                data-bs-toggle="modal" data-bs-target="#modalEditarEmpleado"
                                                data-id="@emp.Id" data-nombre="@emp.Nombre" data-avatar="@emp.AvatarTipo"
                                                data-pin="@emp.Pin" data-rol="@emp.Rol">✏️ Editar</button>
                                        <form asp-action="EliminarEmpleado" method="post">
                                            <input type="hidden" name="id" value="@emp.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                                                    onclick="return confirm('¿Eliminar empleado @emp.Nombre?')">🗑 Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (!Model.Empleados.Any())
                        {
                            <div class="col-12 text-muted">No hay empleados aún.</div>
                        }
                    </div>

                    <hr class="my-4" />

                    <div class="row">
                        <div class="col-md-6">
                            <h5>Tokens para QR</h5>
                            <form asp-action="AgregarToken" method="post" class="d-flex mb-3">
                                <input type="text" name="token" class="form-control me-2" placeholder="token-por-mesa-o-global" required />
                                <button class="btn btn-primary">Añadir Token</button>
                            </form>
                            <ul class="list-group">
                                @foreach(var t in Model.Tokens)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@t</span>
                                        <form asp-action="EliminarToken" method="post" class="m-0">
                                            <input type="hidden" name="token" value="@t" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h5>IP permitidas (lista blanca)</h5>
                            <form asp-action="AgregarIP" method="post" class="d-flex mb-3">
                                <input type="text" name="ip" class="form-control me-2" placeholder="127.0.0.1" required />
                                <button class="btn btn-primary">Añadir IP</button>
                            </form>
                            <ul class="list-group">
                                @foreach(var ip in Model.Ips)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@ip</span>
                                        <form asp-action="EliminarIP" method="post" class="m-0">
                                            <input type="hidden" name="ip" value="@ip" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                            <hr />
                            <h5>Proxies confiables</h5>
                            <form asp-action="AgregarProxy" method="post" class="d-flex mb-3">
                                <input type="text" name="proxy" class="form-control me-2" placeholder="ip.del.proxy" required />
                                <button class="btn btn-primary">Añadir Proxy</button>
                            </form>
                            <ul class="list-group">
                                @foreach(var p in Model.Proxies)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@p</span>
                                        <form asp-action="EliminarProxy" method="post" class="m-0">
                                            <input type="hidden" name="proxy" value="@p" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
                                @* TAB: MESAS (ZONAS) *@
                                <div class="tab-pane fade" id="mesas-tab-pane" role="tabpanel">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="mb-0">Zonas del local</h5>
                                        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaZona">➕ Nueva zona</button>
                                    </div>
                                    <div class="row g-3">
                                        @foreach (var zona in Model.Zonas)
                                        {
                                            <div class="col-12 col-md-6 col-lg-4">
                                                <div class="card shadow-sm">
                                                    <div class="card-body d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <h6 class="mb-0 fw-bold">🏠 @zona.Nombre</h6>
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <a asp-action="MapaZona" asp-route-id="@zona.Id" class="btn btn-sm btn-outline-primary">🗺 Ver mapa</a>
                                                            <button class="btn btn-sm btn-outline-secondary"
                                                                    data-bs-toggle="modal" data-bs-target="#modalRenombrarZona"
                                                                    data-id="@zona.Id" data-nombre="@zona.Nombre">✏️</button>
                                                            <form asp-action="EliminarZona" method="post" class="m-0">
                                                                <input type="hidden" name="id" value="@zona.Id" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                        onclick="return confirm('¿Eliminar la zona @zona.Nombre y desvincular sus mesas?')">🗑</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        @if (!Model.Zonas.Any())
                                        {
                                            <div class="col-12 text-muted">No hay zonas. Añade una para empezar.</div>
                                        }
                                    </div>
                                </div>

                @* TAB: TICKETS *@
                <div class="tab-pane fade" id="tickets-tab-pane" role="tabpanel">
                <style>
                    .ticket-zona {
                        position: relative;
                        min-height: 120px;
                        border: 2px dashed #aaa;
                        border-radius: 8px;
                        background: #f9f9f9;
                        overflow: hidden;
                    }
                    .ticket-elemento {
                        position: absolute;
                        border: 1px solid #999;
                        background: rgba(255,255,255,0.85);
                        cursor: move;
                        user-select: none;
                        box-shadow: 0 1px 4px rgba(0,0,0,.2);
                        border-radius: 4px;
                        padding: 4px 6px;
                        min-width: 60px;
                        min-height: 28px;
                        resize: both;
                        overflow: hidden;
                    }
                    .ticket-elemento .btn-del {
                        position: absolute;
                        top: 2px; right: 2px;
                        font-size: 10px;
                        line-height: 1;
                        padding: 1px 4px;
                    }
                    /* Vista previa */
                    #ticket-preview {
                        width: 300px;
                        min-height: 400px;
                        border: 1px solid #ccc;
                        border-radius: 6px;
                        font-family: monospace;
                        font-size: 12px;
                        background: #fff;
                        padding: 0;
                        box-shadow: 0 2px 8px rgba(0,0,0,.15);
                    }
                    #ticket-preview .zona-prev {
                        min-height: 60px;
                        border-bottom: 1px dashed #ccc;
                        padding: 6px;
                        position: relative;
                    }
                    #ticket-preview .zona-prev.pie { border-top: 1px dashed #ccc; border-bottom: none; }
                    #ticket-preview .cuerpo-prev { padding: 8px; }
                </style>

                <form id="form-ticket" asp-action="GuardarTicketPlantilla" method="post">
                    <input type="hidden" id="cabeceraJson" name="cabeceraJson" value='@Model.Ticket.CabeceraJson' />
                    <input type="hidden" id="pieJson" name="pieJson" value='@Model.Ticket.PieJson' />

                    <div class="row g-4">
                        <!-- Columna editor -->
                        <div class="col-lg-7">
                            <h5>🧾 Configuración de plantilla de ticket</h5>
                            <p class="text-muted small">Arrastra y redimensiona los elementos. Guarda al terminar.</p>

                            <div class="mb-3">
                                <label class="fw-bold">📄 Cabecera del ticket</label>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="agregarTexto('cabecera')">+ Texto</button>
                                    <label class="btn btn-sm btn-outline-secondary mb-0">
                                        + Imagen
                                        <input type="file" class="d-none" accept="image/*" onchange="subirImagen(this,'cabecera')" />
                                    </label>
                                </div>
                                <div class="ticket-zona" id="zona-cabecera" style="height:130px;"></div>
                            </div>

                            <div class="mb-3">
                                <label class="fw-bold">📝 Cuerpo del ticket</label>
                                <div class="border rounded p-3 bg-light">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="chkHora" name="imprimirHora" value="true" @(Model.Ticket.ImprimirHora ? "checked" : "") onchange="actualizarPreview()" />
                                        <label class="form-check-label" for="chkHora">🕐 Imprimir hora</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="chkUsuario" name="imprimirUsuario" value="true" @(Model.Ticket.ImprimirUsuario ? "checked" : "") onchange="actualizarPreview()" />
                                        <label class="form-check-label" for="chkUsuario">👤 Imprimir nombre de usuario</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="chkImpuestos" name="imprimirImpuestos" value="true" @(Model.Ticket.ImprimirImpuestos ? "checked" : "") onchange="actualizarPreview()" />
                                        <label class="form-check-label" for="chkImpuestos">💶 Imprimir desglose de impuestos</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="chkDesglose" name="imprimirDesglose" value="true" @(Model.Ticket.ImprimirDesglose ? "checked" : "") onchange="actualizarPreview()" />
                                        <label class="form-check-label" for="chkDesglose">📋 Imprimir desglose de líneas de productos</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="fw-bold">📄 Pie del ticket</label>
                                <div class="d-flex gap-2 mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="agregarTexto('pie')">+ Texto</button>
                                    <label class="btn btn-sm btn-outline-secondary mb-0">
                                        + Imagen
                                        <input type="file" class="d-none" accept="image/*" onchange="subirImagen(this,'pie')" />
                                    </label>
                                </div>
                                <div class="ticket-zona" id="zona-pie" style="height:130px;"></div>
                            </div>

                            <button type="submit" class="btn btn-success w-100 fw-bold">💾 Guardar plantilla</button>
                        </div>

                        <!-- Vista previa -->
                        <div class="col-lg-5">
                            <h5>👁 Vista previa</h5>
                            <div id="ticket-preview">
                                <div class="zona-prev" id="prev-cabecera"></div>
                                <div class="cuerpo-prev" id="prev-cuerpo"></div>
                                <div class="zona-prev pie" id="prev-pie"></div>
                            </div>
                        </div>
                    </div>
                </form>

                </div><!-- /tickets-tab-pane -->

                @* TAB: QR *@
                <div class="tab-pane fade" id="qr-tab-pane" role="tabpanel">
                    @{
                        var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
                        var zonasQr = Model.Zonas;
                    }
                    <h5 class="mb-3">📱 Códigos QR de todas las mesas</h5>
                    @if (!zonasQr.Any())
                    {
                        <p class="text-muted">No hay zonas ni mesas configuradas.</p>
                    }
                    else
                    {
                        @foreach (var zona in zonasQr)
                        {
                            <h6 class="fw-bold mt-3 mb-2">🏠 @zona.Nombre</h6>
                            <div class="row g-3 mb-3">
                                @foreach (var mesa in zona.Mesas.OrderBy(m => m.NumeroMesa))
                                {
                                    var urlMesa = $"{baseUrl}/Carta/Mesa/{mesa.Slug}";
                                    <div class="col-6 col-sm-4 col-md-3 col-lg-2 text-center">
                                        <div class="border rounded p-2 bg-white shadow-sm">
                                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=@Uri.EscapeDataString(urlMesa)"
                                                 alt="QR @mesa.Nombre" class="img-fluid" style="width:110px;height:110px" />
                                            <div class="mt-1 fw-bold small">@(string.IsNullOrWhiteSpace(mesa.Nombre) ? $"Mesa {mesa.NumeroMesa}" : mesa.Nombre)</div>
                                            <a href="@urlMesa" class="d-block text-muted" style="font-size:0.7rem;word-break:break-all">@urlMesa</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div><!-- /qr-tab-pane -->

            </div>
        </div>
    </div>
</div>

@* ─── MODALES ──────────────────────────────────────────────────────────────── *@

@* Modal nuevo empleado *@
<div class="modal fade" id="modalNuevoEmpleado" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AgregarEmpleado" method="post" enctype="multipart/form-data">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Nuevo empleado</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Avatar</label>
                        <div class="d-flex flex-wrap gap-2 mb-2" id="avatarPicker">
                            @foreach (var av in new[] { "avatar_h1","avatar_h2","avatar_h3","avatar_h4","avatar_m1","avatar_m2","avatar_m3","avatar_m4" })
                            {
                                <label class="cursor-pointer">
                                    <input type="radio" name="avatarTipo" value="@av" class="d-none avatar-radio" @(av == "avatar_h1" ? "checked" : "") />
                                    <img src="/img/avatars/@(av).svg" style="width:52px;height:52px;border-radius:50%;border:3px solid transparent;"
                                         class="avatar-opt" data-av="@av" />
                                </label>
                            }
                        </div>
                        <label class="form-label mt-1">O subir foto:</label>
                        <input type="file" name="foto" class="form-control" accept="image/*" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">Rol</label>
                            <select name="rol" class="form-select">
                                <option value="Camarero">Camarero</option>
                                <option value="Encargado">Encargado</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">PIN (opcional, 4 dígitos)</label>
                            <input type="text" name="pin" class="form-control" maxlength="4" pattern="[0-9]{4}" placeholder="ej: 1234" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Añadir</button>
                </div>
            </div>
        </form>
    </div>
</div>

@* Modal editar empleado *@
<div class="modal fade" id="modalEditarEmpleado" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="EditarEmpleado" method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" id="editEmpId" />
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Editar empleado</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" id="editEmpNombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Avatar</label>
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @foreach (var av in new[] { "avatar_h1","avatar_h2","avatar_h3","avatar_h4","avatar_m1","avatar_m2","avatar_m3","avatar_m4" })
                            {
                                <label class="cursor-pointer">
                                    <input type="radio" name="avatarTipo" value="@av" class="d-none avatar-radio-edit" />
                                    <img src="/img/avatars/@(av).svg" style="width:52px;height:52px;border-radius:50%;border:3px solid transparent;"
                                         class="avatar-opt-edit" data-av="@av" />
                                </label>
                            }
                        </div>
                        <label class="form-label mt-1">O cambiar foto:</label>
                        <input type="file" name="foto" class="form-control" accept="image/*" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">Rol</label>
                            <select name="rol" id="editEmpRol" class="form-select">
                                <option value="Camarero">Camarero</option>
                                <option value="Encargado">Encargado</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">PIN (4 dígitos)</label>
                            <input type="text" name="pin" id="editEmpPin" class="form-control" maxlength="4" pattern="[0-9]{4}" placeholder="dejar vacío = sin PIN" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </div>
        </form>
    </div>
</div>

@* Modal nueva zona *@
<div class="modal fade" id="modalNuevaZona" tabindex="-1">
