<script>
// Selección visual de avatares
document.querySelectorAll('.avatar-opt').forEach(img => {
    img.addEventListener('click', () => {
        document.querySelectorAll('.avatar-opt').forEach(i => i.style.borderColor = 'transparent');
        img.style.borderColor = '#0d6efd';
        img.closest('label').querySelector('input').checked = true;
    });
    if (img.closest('label').querySelector('input').checked)
        img.style.borderColor = '#0d6efd';
});

// Modal editar empleado: rellenar datos
document.getElementById('modalEditarEmpleado')?.addEventListener('show.bs.modal', function(e) {
    const btn = e.relatedTarget;
    document.getElementById('editEmpId').value = btn.dataset.id;
    document.getElementById('editEmpNombre').value = btn.dataset.nombre;
    if (document.getElementById('editEmpPin')) document.getElementById('editEmpPin').value = btn.dataset.pin || '';
    if (document.getElementById('editEmpRol')) document.getElementById('editEmpRol').value = btn.dataset.rol || 'Camarero';
    const av = btn.dataset.avatar;
    document.querySelectorAll('.avatar-opt-edit').forEach(img => {
        img.style.borderColor = img.dataset.av === av ? '#0d6efd' : 'transparent';
    });
    document.querySelectorAll('.avatar-radio-edit').forEach(r => { r.checked = r.value === av; });
});
document.querySelectorAll('.avatar-opt-edit').forEach(img => {
    img.addEventListener('click', () => {
        document.querySelectorAll('.avatar-opt-edit').forEach(i => i.style.borderColor = 'transparent');
        img.style.borderColor = '#0d6efd';
        img.closest('label').querySelector('input').checked = true;
    });
});

// Modal renombrar zona
document.getElementById('modalRenombrarZona')?.addEventListener('show.bs.modal', function(e) {
    const btn = e.relatedTarget;
    document.getElementById('renomZonaId').value = btn.dataset.id;
    document.getElementById('renomZonaNombre').value = btn.dataset.nombre;
});

// Activar pestaña por hash
document.addEventListener('DOMContentLoaded', function() {
    if (location.hash === '#mesas') document.getElementById('mesas-tab')?.click();
    if (location.hash === '#empleados') document.getElementById('empleados-tab')?.click();
    if (location.hash === '#qr') document.getElementById('qr-tab')?.click();
});
</script>
