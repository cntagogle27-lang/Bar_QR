@model Bar_QR.Models.AdminAjustesViewModel

@{
    ViewData["Title"] = "Ajustes";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-secondary text-white">
            <h4 class="mb-0">Ajustes del sistema</h4>
        </div>
        <div class="card-body">
            @if (ViewData["AjustesError"] is string ajustesErrorView)
            {
                <div class="alert alert-danger">@ajustesErrorView</div>
            }
            @if (TempData["AjustesError"] is string ajustesError)
            {
                <div class="alert alert-danger">@ajustesError</div>
            }
            @if (TempData["AjustesOk"] is string ajustesOk)
            {
                <div class="alert alert-success">@ajustesOk</div>
            }

            <ul class="nav nav-tabs mb-4" id="ajustesTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="empleados-tab" data-bs-toggle="tab" data-bs-target="#empleados" type="button" role="tab">
                        👤 Empleados y credenciales
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="mesas-tab" data-bs-toggle="tab" data-bs-target="#mesas-tab-pane" type="button" role="tab">
                        🗺 Mapa de mesas
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="ajustesTabContent">

                @* TAB: EMPLEADOS *@
                <div class="tab-pane fade show active" id="empleados" role="tabpanel">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Correos permitidos para personal</h5>
                            <form asp-action="AgregarEmail" method="post" class="d-flex mb-3">
                                <input type="email" name="email" class="form-control me-2" placeholder="nuevo@correo.com" required />
                                <button class="btn btn-primary">A�adir</button>
                            </form>
                            <ul class="list-group">
                                @foreach(var email in Model.Emails)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="me-3">
                                            <div class="fw-bold">@email</div>
                                            <div class="small text-muted">Enlace de acceso:</div>
                                            <a class="small" href="@Url.Action("Acceso", "Login", new { email }, Context.Request.Scheme)">
                                                @Url.Action("Acceso", "Login", new { email }, Context.Request.Scheme)
                                            </a>
                                        </div>
                                        <form asp-action="EliminarEmail" method="post" class="m-0">
                                            <input type="hidden" name="email" value="@email" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                            <hr />
                            <h5>Tokens para QR</h5>
                            <form asp-action="AgregarToken" method="post" class="d-flex mb-3">
                                <input type="text" name="token" class="form-control me-2" placeholder="token-por-mesa-o-global" required />
                                <button class="btn btn-primary">A�adir Token</button>
                            </form>
                            <ul class="list-group">
                                @foreach(var t in Model.Tokens)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@t</span>
                                        <form asp-action="EliminarToken" method="post" class="m-0">
                                            <input type="hidden" name="token" value="@t" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h5>IP permitidas (lista blanca)</h5>
                            <form asp-action="AgregarIP" method="post" class="d-flex mb-3">
                                <input type="text" name="ip" class="form-control me-2" placeholder="127.0.0.1" required />
                                <button class="btn btn-primary">A�adir IP</button>
                            </form>
                            <ul class="list-group">
                                @foreach(var ip in Model.Ips)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@ip</span>
                                        <form asp-action="EliminarIP" method="post" class="m-0">
                                            <input type="hidden" name="ip" value="@ip" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                            <hr />
                            <h5>Proxies confiables</h5>
                            <form asp-action="AgregarProxy" method="post" class="d-flex mb-3">
                                <input type="text" name="proxy" class="form-control me-2" placeholder="ip.del.proxy" required />
                                <button class="btn btn-primary">A�adir Proxy</button>
                            </form>
                            <ul class="list-group">
                                @foreach(var p in Model.Proxies)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@p</span>
                                        <form asp-action="EliminarProxy" method="post" class="m-0">
                                            <input type="hidden" name="proxy" value="@p" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                @* TAB: MAPA DE MESAS *@
                <div class="tab-pane fade" id="mesas-tab-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Mesas del local</h5>
                        <form asp-action="AgregarMesa" method="post">
                            <button class="btn btn-success btn-sm">➕ Nueva mesa</button>
                        </form>
                    </div>
                    <a asp-action="MapaMesas" class="btn btn-outline-secondary btn-sm mb-3">🗺 Ver mapa completo</a>
                </div>

            </div>
        </div>
    </div>
</div>
