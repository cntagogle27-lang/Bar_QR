@model IEnumerable<Bar_QR.Models.Mesa>

@{
    ViewData["Title"] = "Mapa de Mesas";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>🗺️ Mapa de Mesas</h3>
        <div>
            <form asp-action="AgregarMesa" method="post" class="d-inline">
                <button class="btn btn-success">➕ Nueva mesa</button>
            </form>
            <a asp-action="Ajustes" class="btn btn-outline-secondary ms-2">← Ajustes</a>
        </div>
    </div>

    @if (TempData["MesasOk"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }
    @if (TempData["MesasError"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var mesa in Model)
        {
            var urlMesa = $"{baseUrl}/Carta/Mesa/{mesa.Slug}";
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Mesa @mesa.NumeroMesa</span>
                        <span class="badge @(mesa.Estado == Bar_QR.Models.EstadoMesa.Libre ? "bg-success" : "bg-warning text-dark")">
                            @mesa.Estado
                        </span>
                    </div>
                    <div class="card-body">
                        <form asp-action="EditarMesa" method="post">
                            <input type="hidden" name="id" value="@mesa.Id" />
                            <div class="mb-2">
                                <label class="form-label small text-muted">Nombre</label>
                                <input type="text" name="nombre" class="form-control form-control-sm" value="@mesa.Nombre" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Número</label>
                                <input type="number" name="numero" class="form-control form-control-sm" value="@mesa.NumeroMesa" min="1" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">URL única</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" value="@urlMesa" readonly id="url-@mesa.Id" />
                                    <button type="button" class="btn btn-outline-secondary" onclick="copiarUrl('url-@mesa.Id')">📋</button>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <button type="submit" class="btn btn-primary btn-sm">💾 Guardar</button>
                                <button type="button" class="btn btn-outline-dark btn-sm" onclick="generarQR('@urlMesa', '@mesa.Nombre')">
                                    📲 Ver QR
                                </button>
                            </div>
                        </form>
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 mt-2"
                                onclick="confirmarEliminar(@mesa.Id, '@Html.Raw(mesa.Nombre.Replace("'","\\'"))')">
                            🗑️ Eliminar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Modal QR *@
<div class="modal fade" id="modalQR" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalQRLabel">QR de la mesa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p id="qrUrlTexto" class="small text-muted mb-3"></p>
                <div id="qrCanvas"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="imprimirQR()">🖨️ Imprimir</button>
            </div>
        </div>
    </div>
</div>

@* Modal confirmar eliminar mesa *@
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="background:#1a1a2e;color:#e0e0e0;border:1.5px solid #dc3545;border-radius:14px">
            <div class="modal-body text-center py-4 px-4">
                <div style="font-size:3rem;line-height:1">🗑️</div>
                <h5 class="fw-bold mt-3 mb-1">¿Eliminar mesa?</h5>
                <p id="eliminar-nombre" class="text-secondary small mb-4"></p>
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary flex-grow-1" data-bs-dismiss="modal">Cancelar</button>
                    <form id="form-eliminar" asp-action="EliminarMesa" method="post" class="flex-grow-1">
                        <input type="hidden" name="id" id="eliminar-id" value="0"/>
                        <button type="submit" class="btn btn-danger w-100">Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    function confirmarEliminar(id, nombre) {
        document.getElementById('eliminar-id').value = id;
        document.getElementById('eliminar-nombre').textContent = 'Se eliminará "' + nombre + '" de forma permanente.';
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }

    function copiarUrl(inputId) {
        var el = document.getElementById(inputId);
        el.select();
        document.execCommand('copy');
        alert('URL copiada al portapapeles');
    }

    var modalQR = null;
    function generarQR(url, nombre) {
        document.getElementById('modalQRLabel').textContent = 'QR – ' + nombre;
        document.getElementById('qrUrlTexto').textContent = url;
        var canvas = document.getElementById('qrCanvas');
        canvas.innerHTML = '';
        new QRCode(canvas, { text: url, width: 256, height: 256, correctLevel: QRCode.CorrectLevel.H });
        if (!modalQR) modalQR = new bootstrap.Modal(document.getElementById('modalQR'));
        modalQR.show();
    }

    function imprimirQR() {
        var contenido = document.getElementById('qrCanvas').innerHTML;
        var ventana = window.open('', '_blank');
        ventana.document.write('<html><body style="text-align:center;font-family:sans-serif">'
            + '<h2>' + document.getElementById('modalQRLabel').textContent + '</h2>'
            + '<p>' + document.getElementById('qrUrlTexto').textContent + '</p>'
            + contenido + '</body></html>');
        ventana.document.close();
        ventana.print();
    }
</script>
}
