@model Bar_QR.Models.Producto

@{
	ViewData["Title"] = "Editar Producto";
}

<a href="@Url.Action("Listado","Admin")" class="btn btn-outline-secondary btn-sm mb-3">← Volver al listado</a>
<h1 class="text-primary">✏️ Editar Producto</h1>
<hr />

<div class="row">
	<div class="col-md-6">
		<form asp-action="EditarProducto" method="post" enctype="multipart/form-data" class="shadow p-4 rounded bg-light">
			<input type="hidden" asp-for="Id" />
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<div class="form-group mb-3">
				<label asp-for="Nombre" class="control-label fw-bold">Nombre del Producto</label>
				<input asp-for="Nombre" class="form-control" />
				<span asp-validation-for="Nombre" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="Precio" class="control-label fw-bold">Precio (€)</label>
				<div class="input-group">
					<input asp-for="Precio" class="form-control" type="number" step="0.01" />
					<span class="input-group-text">€</span>
				</div>
				<span asp-validation-for="Precio" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="Grupo" class="control-label fw-bold">Grupo / Categoría</label>
				<select asp-for="Grupo" class="form-select"
						asp-items="Html.GetEnumSelectList<Bar_QR.Models.GrupoProducto>()">
				</select>
				<span asp-validation-for="Grupo" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label asp-for="DestinoImpresion" class="control-label fw-bold">📍 Destino de Comanda</label>
				<select asp-for="DestinoImpresion" class="form-select"
						asp-items="Html.GetEnumSelectList<Bar_QR.Models.DestinoImpresion>()">
				</select>
				<span asp-validation-for="DestinoImpresion" class="text-danger"></span>
			</div>

			<div class="form-group mb-3">
				<label class="control-label fw-bold">📷 Foto actual</label><br />
				@if (Model.FotoData != null)
				{
					<img src="/Admin/FotoProducto/@Model.Id" alt="Foto actual" class="rounded mb-2" style="max-height:120px;" />
					<div class="form-text">Sube una nueva para reemplazarla.</div>
				}
				else
				{
					<span class="text-muted small">Sin foto.</span>
				}
			</div>

			<div class="form-group mb-4">
				<label for="foto" class="control-label fw-bold">📷 Nueva foto (opcional)</label>
				<input type="file" name="foto" id="foto" class="form-control" accept="image/*" />
			</div>

			<div class="form-group">
				<button type="submit" class="btn btn-primary w-100 fw-bold">
					💾 Guardar Cambios
				</button>
			</div>
		</form>
	</div>
</div>

<div class="mt-3">
	<a asp-action="Listado" class="btn btn-secondary btn-sm">⬅️ Volver al Listado</a>
</div>

@section Scripts {
	@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
