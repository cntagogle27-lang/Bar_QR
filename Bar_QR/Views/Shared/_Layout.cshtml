<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bar_QR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header @(ViewData["HideNav"] != null ? "style=display:none" : "")>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Bar_QR</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!User.IsInRole("Camarero") && !User.IsInRole("Encargado"))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-controller="Carta" asp-action="Index">🍴 Ver Carta</a>
                        </li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item border-start ps-3 ms-3 text-muted d-flex align-items-center">
                                Hola, @User.Identity.Name
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-bold" asp-controller="Admin" asp-action="Listado">⚙️ Gestión</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-bold" style="color:#6ea8fe;" asp-controller="Admin" asp-action="ControlMesas">🗂️ Control mesas</a>
                                </li>
                            }

                            @if (User.IsInRole("Camarero"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-success fw-bold" asp-controller="Staff" asp-action="Index">🧾 Mesas</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Login" asp-action="Logout">🚪 Salir</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Bar_QR - <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>