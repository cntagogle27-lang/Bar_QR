@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Acceso Bar_QR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: radial-gradient(circle, #2c3e50, #000000);
            height: 100vh;
            display: flex;
            align-items: center;
            color: white;
            overflow: hidden;
        }

        .btn-perfil {
            height: 160px;
            border-radius: 25px;
            font-size: 22px;
            transition: 0.3s;
            border: none;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

            .btn-perfil:hover {
                transform: translateY(-10px);
                filter: brightness(1.2);
            }

        /* Teclado Compacto */
        .pin-container {
            max-width: 280px;
            margin: 0 auto;
        }

        .pin-btn {
            width: 65px;
            height: 65px;
            margin: 8px;
            border-radius: 50%;
            font-size: 24px;
            font-weight: bold;
            border: 2px solid #eee;
            transition: 0.2s;
        }

            .pin-btn:active {
                background-color: #eee;
                color: #000;
            }

        #pinInput {
            background: #f8f9fa;
            color: #333;
            border: 2px solid #ddd;
            font-size: 35px;
            letter-spacing: 15px;
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-5">🏨 BAR_QR LOG IN</h1>

        <div class="row justify-content-center g-4">
            <div class="col-6 col-md-3">
                <form asp-action="AccesoCamarero" method="post">
                    <input type="hidden" name="nombre" value="Paco" />
                    <button type="submit" class="btn btn-primary btn-perfil shadow-lg">
                        <span class="display-4">🧔</span> Paco
                    </button>
                </form>
            </div>

            <div class="col-6 col-md-3">
                <form asp-action="AccesoCamarero" method="post">
                    <input type="hidden" name="nombre" value="Luis" />
                    <button type="submit" class="btn btn-info text-white btn-perfil shadow-lg">
                        <span class="display-4">👦</span> Luis
                    </button>
                </form>
            </div>

            <div class="col-6 col-md-3">
                <button class="btn btn-danger btn-perfil shadow-lg" data-bs-toggle="modal" data-bs-target="#modalPin">
                    <span class="display-4">⚙️</span> Admin
                </button>
            </div>
        </div>

    <!-- Acceso por correo movido: ahora el sistema detecta al entrar y redirige automáticamente -->
    </div>

    <div class="modal fade" id="modalPin" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-dark border-0 shadow-lg" style="border-radius: 30px; width: 350px; margin: auto;">
                <div class="modal-body p-4">
                    <h4 class="text-center fw-bold mb-4">CÓDIGO ADMIN</h4>
                    <form asp-action="VerificarAdmin" method="post">
                        <input type="password" name="pin" id="pinInput" class="form-control text-center mb-4" readonly maxlength="4" />

                        <div class="pin-container text-center">
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(1)">1</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(2)">2</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(3)">3</button>
                            </div>
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(4)">4</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(5)">5</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(6)">6</button>
                            </div>
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(7)">7</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(8)">8</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(9)">9</button>
                            </div>
                            <div class="d-flex justify-content-center align-items-center">
                                <button type="button" class="btn btn-link text-danger fw-bold" style="text-decoration:none; width:65px;" onclick="cls()">BORRAR</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(0)">0</button>
                                <button type="submit" class="btn btn-success pin-btn shadow">OK</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function press(n) {
            const i = document.getElementById('pinInput');
            if(i.value.length < 4) i.value += n;
        }
        function cls() { document.getElementById('pinInput').value = ''; }
    </script>
</body>
</html>