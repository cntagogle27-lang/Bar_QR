@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Bar_QR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: radial-gradient(circle, #2c3e50, #000); min-height: 100vh; display: flex; align-items: center; justify-content: center; color: white; }
        .login-card { background: rgba(255,255,255,.07); border-radius: 20px; padding: 3rem 2.5rem; max-width: 420px; width: 100%; text-align: center; box-shadow: 0 8px 32px rgba(0,0,0,.5); backdrop-filter: blur(6px); }
        .btn-google { background: #fff; color: #444; font-weight: 700; font-size: 1.1rem; border-radius: 50px; padding: .85rem 2rem; border: none; width: 100%; display: flex; align-items: center; justify-content: center; gap: .75rem; box-shadow: 0 4px 14px rgba(0,0,0,.3); transition: .2s; text-decoration: none; }
        .btn-google:hover { background: #f0f0f0; transform: translateY(-2px); }
        .divider { color: #aaa; margin: 1.5rem 0; font-size: .85rem; }
        .btn-pin { background: transparent; border: 1px solid rgba(255,255,255,.3); color: #ccc; font-size: .85rem; border-radius: 50px; padding: .4rem 1.2rem; }
        .btn-pin:hover { background: rgba(255,255,255,.1); color: #fff; }
        .pin-btn { width:65px; height:65px; margin:8px; border-radius:50%; font-size:24px; font-weight:bold; border:2px solid #eee; transition:.2s; }
        .pin-btn:active { background:#eee; color:#000; }
        #pinInput { background:#f8f9fa; color:#333; border:2px solid #ddd; font-size:35px; letter-spacing:15px; border-radius:10px; }
    </style>
</head>
<body>
    <div class="login-card">
        <div style="font-size:3.5rem">&#127976;</div>
        <h2 class="fw-bold mt-2 mb-1">Bar_QR</h2>
        <p class="text-secondary mb-4">Identifícate con tu cuenta Google</p>

        @if (TempData["LoginError"] is string loginError)
        {
            <div class="alert alert-danger fw-bold py-2">@loginError</div>
        }

        <a href="@Url.Action("GoogleLogin","Login")" class="btn-google mb-2">
            <svg width="22" height="22" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.35-8.16 2.35-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Iniciar sesión con Google
        </a>

        <div class="divider">── acceso de administrador ──</div>
        <button class="btn-pin" data-bs-toggle="modal" data-bs-target="#modalPin">⚙️ Admin PIN</button>
    </div>

    <div class="modal fade" id="modalPin" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-dark border-0 shadow-lg" style="border-radius:30px;width:350px;margin:auto">
                <div class="modal-body p-4">
                    <h4 class="text-center fw-bold mb-4">CÓDIGO ADMIN</h4>
                    <form asp-action="VerificarAdmin" method="post">
                        <input type="password" name="pin" id="pinInput" class="form-control text-center mb-4" readonly maxlength="4" />
                        <div class="text-center">
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(1)">1</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(2)">2</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(3)">3</button>
                            </div>
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(4)">4</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(5)">5</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(6)">6</button>
                            </div>
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(7)">7</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(8)">8</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(9)">9</button>
                            </div>
                            <div class="d-flex justify-content-center align-items-center">
                                <button type="button" class="btn btn-link text-danger fw-bold" style="text-decoration:none;width:65px" onclick="cls()">BORRAR</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(0)">0</button>
                                <button type="submit" class="btn btn-success pin-btn shadow">OK</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function press(n) { var i = document.getElementById('pinInput'); if (i.value.length < 4) i.value += n; }
        function cls() { document.getElementById('pinInput').value = ''; }
    </script>
</body>
</html>
