@model List<Bar_QR.Models.Empleado>
@{
    Layout = null;
    var adminEmail = ViewData["GoogleEmail"] as string;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Seleccionar perfil</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: radial-gradient(circle, #2c3e50, #000000); min-height: 100vh; display: flex; align-items: center; justify-content: center; color: white; }
        .perfil-card { background: rgba(255,255,255,0.07); border-radius: 24px; padding: 2.5rem 2rem; max-width: 520px; width: 100%; text-align: center; box-shadow: 0 8px 32px rgba(0,0,0,.5); }
        .btn-perfil { border-radius: 20px; padding: 1.1rem; font-size: 1.1rem; font-weight: 700; width: 100%; transition: .2s; border: 2px solid rgba(255,255,255,.15); background: rgba(255,255,255,.1); color: white; }
        .btn-perfil:hover { background: rgba(255,255,255,.25); transform: translateY(-3px); color: white; }
        .btn-admin { background: rgba(220,53,69,.3); border-color: rgba(220,53,69,.6); }
        .btn-admin:hover { background: rgba(220,53,69,.5); }
        .pin-btn { width: 65px; height: 65px; margin: 8px; border-radius: 50%; font-size: 24px; font-weight: bold; border: 2px solid #eee; transition: .2s; }
        .pin-btn:active { background: #eee; color: #000; }
        #pinInput { background: #f8f9fa; color: #333; border: 2px solid #ddd; font-size: 35px; letter-spacing: 15px; border-radius: 10px; }
    </style>
</head>
<body>
    <div class="perfil-card">
        <div style="font-size:3rem;margin-bottom:.5rem">👋</div>
        <h2 class="fw-bold mb-1">Hola, <span style="color:#7dd3fc">@(adminEmail?.Split("@")[0])</span></h2>
        <p class="text-white-50 mb-4">Selecciona con quien vas a trabajar hoy</p>

        @if (TempData["LoginError"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        @if (!Model.Any())
        {
            <div class="alert alert-warning">No hay empleados aún. Añade empleados desde el panel de administración.</div>
        }

        <div class="d-grid gap-3">
            @foreach (var emp in Model)
            {
                <form asp-action="SeleccionarPerfil" method="post">
                    <input type="hidden" name="empleadoId" value="@emp.Id" />
                    <button type="submit" class="btn-perfil">
                        @if (emp.AvatarTipo == "custom" && emp.FotoData != null)
                        {
                            <img src="/Login/AvatarEmpleado/@emp.Id" style="width:32px;height:32px;border-radius:50%;object-fit:cover;margin-right:8px" />
                        }
                        else
                        {
                            <span style="margin-right:8px">🧑‍🍳</span>
                        }
                        @emp.Nombre
                    </button>
                </form>
            }

            <hr style="border-color:rgba(255,255,255,.2)" />

            <button type="button" class="btn-perfil btn-admin" data-bs-toggle="modal" data-bs-target="#modalPin">
                ⚙️ Entrar como Administrador
            </button>
        </div>
    </div>

    @* Modal PIN admin *@
    <div class="modal fade" id="modalPin" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-dark border-0 shadow-lg" style="border-radius:30px;width:350px;margin:auto">
                <div class="modal-body p-4">
                    <h4 class="text-center fw-bold mb-4">CÓDIGO ADMIN</h4>
                    <form asp-action="SeleccionarPerfil" method="post">
                        <input type="hidden" name="emailCamarero" value="" />
                        <input type="password" name="adminPin" id="pinInput" class="form-control text-center mb-4" readonly maxlength="4" />
                        <div class="text-center">
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(1)">1</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(2)">2</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(3)">3</button>
                            </div>
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(4)">4</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(5)">5</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(6)">6</button>
                            </div>
                            <div class="d-flex justify-content-center">
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(7)">7</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(8)">8</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(9)">9</button>
                            </div>
                            <div class="d-flex justify-content-center align-items-center">
                                <button type="button" class="btn btn-link text-danger fw-bold" style="text-decoration:none;width:65px" onclick="cls()">BORRAR</button>
                                <button type="button" class="btn btn-light pin-btn shadow-sm" onclick="press(0)">0</button>
                                <button type="submit" class="btn btn-success pin-btn shadow">OK</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function press(n) { const i = document.getElementById("pinInput"); if(i.value.length < 4) i.value += n; }
        function cls() { document.getElementById("pinInput").value = ""; }
    </script>
</body>
</html>
